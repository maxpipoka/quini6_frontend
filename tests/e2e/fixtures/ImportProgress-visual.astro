---
// Visual test fixture for ImportProgress component
import ImportProgress from '@/components/admin/ImportProgress';
import { sampleProps } from './visual-test-data';

const { state = 'default' } = Astro.props;
const props = sampleProps.ImportProgress[state as keyof typeof sampleProps.ImportProgress] ?? sampleProps.ImportProgress.default;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Visual Test: ImportProgress - {state}</title>
    <style>
      /* Disable animations for consistent screenshots */
      [data-test-animate="false"],
      [data-test-animate="false"] *,
      [data-test-animate="false"] *::before,
      [data-test-animate="false"] *::after {
        animation-duration: 0s !important;
        animation-delay: -1ms !important;
        transition-duration: 0s !important;
        transition-delay: -1ms !important;
      }
    </style>
  </head>
  <body data-test-animate="false" class="min-h-screen p-8 bg-neutral-50 dark:bg-neutral-900">
    <ImportProgress {...props} client:load />
  </body>
</html>