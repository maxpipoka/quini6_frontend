---
import AdminLayout from '../layout.astro';
import { DrawTableFilters } from '@components/admin/DrawTableFilters.tsx';
import Table from '@components/ui/Table.astro';
import Modal from '@components/ui/Modal.astro';
import { DrawFormWizard } from '@components/admin/DrawFormWizard.tsx';
---

<script>
  // This page needs client-side interactivity for the modal and filters
  // We'll handle data fetching and state management in the script
</script>

<script is:inline>
  // Client-side data fetching and state management
  // This runs in the browser after hydration
  let currentPage = 1;
  let currentFilters = { startDate: '', endDate: '', modality: '' };
  let totalPages = 1;

  async function fetchDraws(page = 1, filters = currentFilters) {
    const params = new URLSearchParams({
      page: page.toString(),
      limit: '20',
    });

    if (filters.startDate) params.append('startDate', filters.startDate);
    if (filters.endDate) params.append('endDate', filters.endDate);
    if (filters.modality) params.append('modality', filters.modality);

    const response = await fetch(`/api/admin/draws?${params.toString()}`, {
      credentials: 'include',
    });

    if (!response.ok) {
      throw new Error('Error al cargar sorteos');
    }

    return response.json();
  }

  async function deleteDraw(id: string) {
    const response = await fetch(`/api/admin/draws/${id}`, {
      method: 'DELETE',
      credentials: 'include',
      headers: {
        'X-CSRF-Token': window.getCsrfToken?.() ?? '',
      },
    });

    if (!response.ok) {
      const error = await response.json();
      throw new Error(error.message || 'Error al eliminar sorteo');
    }
  }

  function getCsrfToken(): string | null {
    const match = document.cookie.match(/(?:^|; )csrf_token=([^;]*)/);
    return match ? decodeURIComponent(match[1]) : null;
  }
  window.getCsrfToken = getCsrfToken;

  function showToast(message: string, type: 'success' | 'error' = 'success') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = `toast ${type} flex items-center gap-3 px-4 py-3 rounded-lg shadow-lg animate-slide-in`;
    toast.innerHTML = `
      <span class="text-sm">${message}</span>
      <button class="ml-2 text-current opacity-70 hover:opacity-100" onclick="this.parentElement.remove()">×</button>
    `;
    container.appendChild(toast);
    setTimeout(() => toast.remove(), 5000);
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', async () => {
    await loadDraws();
  });

  async function loadDraws() {
    const tableBody = document.getElementById('draws-table-body');
    const emptyState = document.getElementById('empty-state');
    const pagination = document.getElementById('pagination');

    if (tableBody) {
      tableBody.innerHTML =
        '<tr><td colspan="5" class="text-center py-8"><span class="loading loading-spinner loading-lg"></span></td></tr>';
    }

    try {
      const data = await fetchDraws(currentPage, currentFilters);
      renderTable(data.data);
      renderPagination(data.page, data.totalPages);
    } catch (error) {
      console.error('Error loading draws:', error);
      if (tableBody) {
        tableBody.innerHTML = `<tr><td colspan="5" class="text-center py-8 text-error">Error al cargar sorteos</td></tr>`;
      }
    }
  }

  function renderTable(draws: DrawSummary[]) {
    const tableBody = document.getElementById('draws-table-body');
    const emptyState = document.getElementById('empty-state');

    if (!tableBody) return;

    if (draws.length === 0) {
      tableBody.innerHTML = '';
      if (emptyState) emptyState.classList.remove('hidden');
      return;
    }

    if (emptyState) emptyState.classList.add('hidden');

    tableBody.innerHTML = draws
      .map((draw) => {
        const resultsHtml = draw.results
          .map(
            (r) => `
        <span class="inline-flex items-center gap-1 px-2 py-1 rounded bg-primary/10 text-primary text-xs font-mono">
          ${r.modality.charAt(0) + r.modality.slice(1).toLowerCase().replace('_', ' ')}: ${r.numbers.map((n) => formatDrawNumber(n)).join(' ')}
        </span>
      `
          )
          .join(' ');

        return `
        <tr class="dark:hover:bg-neutral-800/50 transition-colors hover:bg-neutral-50">
          <td class="text-text-primary px-4 py-3 text-sm font-mono">${formatDrawNumber(draw.officialNumber)}</td>
          <td class="text-text-primary px-4 py-3 text-sm">${new Date(draw.drawDate).toLocaleDateString('es-AR')}</td>
          <td class="text-text-primary px-4 py-3 text-sm flex flex-wrap gap-1">${resultsHtml}</td>
          <td class="text-text-primary px-4 py-3 text-sm">
            <div class="flex items-center gap-2">
              <button
                data-action="edit"
                data-id="${draw.id}"
                class="flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-primary hover:bg-primary/10 rounded-lg transition-colors"
              >
                <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                Editar
              </button>
              <button
                data-action="delete"
                data-id="${draw.id}"
                class="flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-error hover:bg-error/10 rounded-lg transition-colors"
              >
                <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                Eliminar
              </button>
            </div>
          </td>
        </tr>
      `;
      })
      .join('');

    // Attach event listeners
    tableBody.querySelectorAll('[data-action="edit"]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        if (id) openEditModal(id);
      });
    });

    tableBody.querySelectorAll('[data-action="delete"]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        if (
          id &&
          confirm('¿Está seguro de eliminar este sorteo? Esta acción no se puede deshacer.')
        ) {
          try {
            await deleteDraw(id);
            showToast('Sorteo eliminado correctamente', 'success');
            await loadDraws();
          } catch (error) {
            showToast(error instanceof Error ? error.message : 'Error al eliminar', 'error');
          }
        }
      });
    });
  }

  function renderPagination(page: number, total: number) {
    const pagination = document.getElementById('pagination');
    if (!pagination) return;

    currentPage = page;
    totalPages = total;

    if (total <= 1) {
      pagination.innerHTML = '';
      return;
    }

    let html = '<nav class="flex items-center justify-center gap-2" aria-label="Paginación">';

    // Previous button
    html += `
      <button
        data-page="${page - 1}"
        ${page === 1 ? 'disabled' : ''}
        class="px-3 py-1.5 text-sm font-medium text-text-secondary transition-colors hover:text-text-primary hover:bg-surface rounded-lg disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Anterior
      </button>
    `;

    // Page numbers
    const start = Math.max(1, page - 2);
    const end = Math.min(total, page + 2);

    if (start > 1) {
      html += `<button data-page="1" class="px-3 py-1.5 text-sm font-medium text-text-secondary transition-colors hover:text-text-primary hover:bg-surface rounded-lg">1</button>`;
      if (start > 2) html += `<span class="px-2 text-text-muted">…</span>`;
    }

    for (let i = start; i <= end; i++) {
      html += `
        <button
          data-page="${i}"
          ${i === page ? 'aria-current="page"' : ''}
          class="px-3 py-1.5 text-sm font-medium rounded-lg transition-colors ${i === page ? 'bg-primary text-white' : 'text-text-secondary hover:text-text-primary hover:bg-surface'}"
        >
          ${i}
        </button>
      `;
    }

    if (end < total) {
      if (end < total - 1) html += `<span class="px-2 text-text-muted">…</span>`;
      html += `<button data-page="${total}" class="px-3 py-1.5 text-sm font-medium text-text-secondary transition-colors hover:text-text-primary hover:bg-surface rounded-lg">${total}</button>`;
    }

    // Next button
    html += `
      <button
        data-page="${page + 1}"
        ${page === total ? 'disabled' : ''}
        class="px-3 py-1.5 text-sm font-medium text-text-secondary transition-colors hover:text-text-primary hover:bg-surface rounded-lg disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Siguiente
      </button>
    `;

    html += '</nav>';
    pagination.innerHTML = html;

    pagination.querySelectorAll('[data-page]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const page = parseInt((e.currentTarget as HTMLElement).dataset.page || '1');
        if (page !== currentPage && page >= 1 && page <= totalPages) {
          await loadDraws();
        }
      });
    });
  }

  // Modal handling
  let currentDrawId: string | null = null;
  let isEditing = false;

  const createModal = document.getElementById('create-modal');
  const editModal = document.getElementById('edit-modal');

  function openCreateModal() {
    isEditing = false;
    currentDrawId = null;
    if (createModal) {
      (createModal as any).showModal?.();
      createModal.classList.remove('hidden');
    }
  }

  async function openEditModal(id: string) {
    isEditing = true;
    currentDrawId = id;
    const editModalContent = document.getElementById('edit-modal-content');
    if (editModalContent) {
      editModalContent.innerHTML =
        '<div class="flex justify-center py-8"><span class="loading loading-spinner loading-lg"></span></div>';
    }
    if (editModal) {
      (editModal as any).showModal?.();
      editModal.classList.remove('hidden');
      editModal.dataset.drawId = id;
    }

    try {
      const response = await fetch(`/api/admin/draws/${id}`, { credentials: 'include' });
      if (!response.ok) throw new Error('Error al cargar sorteo');
      const draw = await response.json();
      // The DrawFormWizard in edit modal will be initialized with draw data
      if (editModalContent) {
        // Re-render with data - the React component will handle this
        // We'll use a custom event to pass data to the React island
        window.dispatchEvent(new CustomEvent('draw-data-loaded', { detail: draw }));
      }
    } catch (error) {
      console.error('Error loading draw:', error);
      if (editModalContent) {
        editModalContent.innerHTML = `<p class="text-center text-error py-8">Error al cargar sorteo</p>`;
      }
    }
  }

  function closeModals() {
    if (createModal) {
      (createModal as any).close?.();
      createModal.classList.add('hidden');
    }
    if (editModal) {
      (editModal as any).close?.();
      editModal.classList.add('hidden');
    }
    currentDrawId = null;
    isEditing = false;
  }

  // Make closeModals available globally for React island onCancel handlers
  window.closeModals = closeModals;

  async function handleCreateSubmit(data: any) {
    try {
      const response = await fetch('/api/admin/draws', {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': getCsrfToken() || '',
        },
        body: JSON.stringify(data),
      });

      if (!response.ok) {
        let message = 'Error al guardar sorteo';
        try {
          const errorData: unknown = await response.json();
          // Manual type check instead of type guard
          const isValidError =
            errorData !== null &&
            typeof errorData === 'object' &&
            'message' in errorData &&
            typeof (errorData as Record<string, unknown>).message === 'string';
          if (isValidError) {
            message = String((errorData as Record<string, unknown>).message);
          }
        } catch {
          // ignore parse error
        }
        throw new Error(message);
      }

      showToast('Sorteo creado correctamente', 'success');
      closeModals();
      await loadDraws();
    } catch (error) {
      showToast(error instanceof Error ? error.message : 'Error al guardar', 'error');
      throw error;
    }
  }

  async function handleEditSubmit(data: any) {
    if (!currentDrawId) return;
    try {
      const response = await fetch(`/api/admin/draws/${currentDrawId}`, {
        method: 'PATCH',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': getCsrfToken() || '',
        },
        body: JSON.stringify(data),
      });

      if (!response.ok) {
        let message = 'Error al actualizar sorteo';
        try {
          const errorData: unknown = await response.json();
          // Manual type check instead of type guard
          const isValidError =
            errorData !== null &&
            typeof errorData === 'object' &&
            'message' in errorData &&
            typeof (errorData as Record<string, unknown>).message === 'string';
          if (isValidError) {
            message = String((errorData as Record<string, unknown>).message);
          }
        } catch {
          // ignore parse error
        }
        throw new Error(message);
      }

      showToast('Sorteo actualizado correctamente', 'success');
      closeModals();
      await loadDraws();
    } catch (error) {
      showToast(error instanceof Error ? error.message : 'Error al guardar', 'error');
      throw error;
    }
  }

  function handleCancel() {
    closeModals();
  }

  // Handle filter changes
  window.addEventListener('filters-changed', async (e: CustomEvent) => {
    currentFilters = e.detail;
    currentPage = 1;
    await loadDraws();
  });

  // Handle form submissions from DrawFormWizard
  window.addEventListener('draw-form-submit', async (e: CustomEvent) => {
    const { data, isEditing } = e.detail;
    if (isEditing && currentDrawId) {
      await handleEditSubmit(data, currentDrawId);
    } else {
      await handleCreateSubmit(data);
    }
  });

  // Handle cross-tab refresh from import wizard
  window.addEventListener('draws:refresh', async () => {
    await loadDraws();
  });

  async function handleCreateSubmit(data: any) {
    try {
      const response = await fetch('/api/admin/draws', {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': getCsrfToken() || '',
        },
        body: JSON.stringify(data),
      });

      if (!response.ok) {
        const errorData: unknown = await response.json();
        // Manual type check instead of assuming error.message exists
        const isValidError =
          errorData !== null &&
          typeof errorData === 'object' &&
          'message' in errorData &&
          typeof (errorData as Record<string, unknown>).message === 'string';
        const message = isValidError
          ? String((errorData as Record<string, unknown>).message)
          : 'Error al guardar sorteo';
        throw new Error(message);
      }

      showToast('Sorteo creado correctamente', 'success');
      closeModals();
      await loadDraws();
    } catch (error) {
      showToast(error instanceof Error ? error.message : 'Error al guardar', 'error');
      throw error;
    }
  }

  async function handleEditSubmit(data: any, drawId: string) {
    try {
      const response = await fetch(`/api/admin/draws/${drawId}`, {
        method: 'PATCH',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': getCsrfToken() || '',
        },
        body: JSON.stringify(data),
      });

      if (!response.ok) {
        const errorData: unknown = await response.json();
        // Manual type check instead of assuming error.message exists
        const isValidError =
          errorData !== null &&
          typeof errorData === 'object' &&
          'message' in errorData &&
          typeof (errorData as Record<string, unknown>).message === 'string';
        const message = isValidError
          ? String((errorData as Record<string, unknown>).message)
          : 'Error al actualizar sorteo';
        throw new Error(message);
      }

      showToast('Sorteo actualizado correctamente', 'success');
      closeModals();
      await loadDraws();
    } catch (error) {
      showToast(error instanceof Error ? error.message : 'Error al guardar', 'error');
      throw error;
    }
  }
</script>

<AdminLayout title="Gestión de Sorteos - Admin Quini 6">
  <div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="font-display text-2xl font-bold text-text-primary">Gestión de Sorteos</h1>
        <p class="mt-1 text-text-secondary">Administra los sorteos del Quini 6</p>
      </div>
      <div class="flex items-center gap-3">
        <a
          href="/admin/imports/upload"
          class="focus:ring-primary inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-4 py-2.5 text-sm font-medium text-text-primary transition-colors hover:bg-surface-elevated focus:outline-none focus:ring-2 focus:ring-offset-2"
        >
          <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg
          >
          Importar Sorteos
        </a>
        <button
          id="create-draw-btn"
          class="bg-primary hover:bg-primary/90 focus:ring-primary flex items-center gap-2 rounded-lg px-4 py-2.5 text-white transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-surface"
        >
          <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4v16m8-8H4"></path></svg
          >
          Crear Sorteo
        </button>
      </div>
    </div>

    <!-- Filters -->
    <DrawTableFilters client:load />

    <!-- Draws Table -->
    <div class="overflow-hidden rounded-xl border border-border bg-surface-elevated">
      <div class="overflow-x-auto">
        <Table
          columns={[
            { key: 'officialNumber', header: 'Nº Oficial', align: 'center' },
            { key: 'drawDate', header: 'Fecha', align: 'center' },
            { key: 'results', header: 'Resultados', render: () => ({ html: '' }) }, // Handled by JS
            { key: 'actions', header: 'Acciones', align: 'center', render: () => ({ html: '' }) }, // Handled by JS
          ]}
          data={[]}
          rowKey="id"
          emptyState="No hay sorteos registrados"
          loadingState={true}
          loadingText="Cargando sorteos..."
          aria-label="Tabla de sorteos"
        >
          <tbody id="draws-table-body" slot="tbody" class="divide-y divide-border"></tbody>
        </Table>
      </div>

      <div id="pagination" class="border-t border-border px-4 py-3"></div>
    </div>

    <!-- Create Modal -->
    <Modal
      id="create-modal"
      title="Crear Nuevo Sorteo"
      isOpen={false}
      class="max-h-[90vh] max-w-3xl overflow-hidden"
    >
      <div id="create-modal-content" class="p-0">
        <DrawFormWizard
          client:visible
          isEditing={false}
          onSubmit={(data) => {
            window.dispatchEvent(
              new CustomEvent('draw-form-submit', {
                detail: { data, isEditing: false },
              })
            );
          }}
          onCancel={() => {
            // eslint-disable-next-line @typescript-eslint/no-unsafe-call
            window.closeModals?.();
          }}
        />
      </div>
    </Modal>

    <!-- Edit Modal -->
    <Modal
      id="edit-modal"
      title="Editar Sorteo"
      isOpen={false}
      class="max-h-[90vh] max-w-3xl overflow-hidden"
    >
      <div id="edit-modal-content" class="p-0">
        <DrawFormWizard
          client:visible
          isEditing={true}
          onSubmit={(data) => {
            const editModal = document.getElementById('edit-modal');
            const drawId = editModal?.dataset.drawId ?? '';
            window.dispatchEvent(
              new CustomEvent('draw-form-submit', {
                detail: { data, isEditing: true, drawId },
              })
            );
          }}
          onCancel={() => {
            // eslint-disable-next-line @typescript-eslint/no-unsafe-call
            window.closeModals?.();
          }}
        />
      </div>
    </Modal>

    <!-- Toast Container -->
    <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2"></div>
  </div>

  <script>
    // Initialize create button
    const createBtn = document.getElementById('create-draw-btn');
    createBtn?.addEventListener('click', () => {
      openCreateModal();
    });

    // Close modals on backdrop click
    document.querySelectorAll('[id$="-modal"]').forEach((modal) => {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModals();
        }
      });
    });
  </script>

  <style>
    .toast {
      background: var(--color-surface-elevated);
      border: 1px solid var(--color-border);
    }
    .toast.success {
      border-left: 4px solid var(--color-success);
    }
    .toast.error {
      border-left: 4px solid var(--color-error);
    }
    @keyframes slide-in {
      from {
        opacity: 0;
        transform: translateX(100%);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }
    .animate-slide-in {
      animation: slide-in 0.3s ease-out;
    }
  </style>
</AdminLayout>
