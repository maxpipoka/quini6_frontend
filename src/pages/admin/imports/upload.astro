---
import AdminLayout from '../layout.astro';
import { ImportWizard } from '../../../components/admin/ImportWizard.tsx';
---

<AdminLayout title="Importar Sorteos - Admin Quini 6">
  <div class="max-w-4xl mx-auto space-y-6">
    <div>
      <h1 class="font-display text-2xl font-bold text-text-primary">Importar Sorteos</h1>
      <p class="mt-1 text-text-secondary">Carga masiva de sorteos desde archivo CSV o Excel</p>
    </div>

    <ImportWizard client:visible />
  </div>
</AdminLayout>