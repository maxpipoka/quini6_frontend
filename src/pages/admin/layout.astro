---
import Layout from '../../layouts/Layout.astro';
import { Sidebar } from '../../components/admin/Sidebar.tsx';

const plausibleDomain = import.meta.env.VITE_PLAUSIBLE_DOMAIN ?? '';
---

<Layout title="Admin - Quini 6">
  <slot name="head-scripts">
    {
      plausibleDomain && (
        <script data-domain={plausibleDomain} src="https://plausible.io/js/script.js" defer />
      )
    }
  </slot>

  <style>
    .min-h-screen bg-neutral-50 dark:bg-neutral-900 {
      min-height: 100vh;
      display: flex;
    }
    .fixed inset-y-0 left-0 z-30 bg-surface border-r border-border transition-all duration-300 {
      width: var(--sidebar-width);
      height: 100vh;
      position: fixed;
      left: 0;
      top: 0;
      background: var(--color-surface-elevated);
      border-right: 1px solid var(--color-border);
      transition: width var(--admin-transition);
      z-index: 30;
      display: flex;
      flex-direction: column;
    }
    .fixed
      inset-y-0
      left-0
      z-40
      bg-surface
      border-r
      border-border
      transition-all
      duration-300.w-16 {
      width: var(--sidebar-w-16-width);
    }
    .flex-1 p-6 lg:p-8 {
      flex: 1;
      margin-left: var(--sidebar-width);
      min-height: 100vh;
      transition: margin-left var(--admin-transition);
      position: relative;
      z-index: 40;
    }
    .fixed
      inset-y-0
      left-0
      z-40
      bg-surface
      border-r
      border-border
      transition-all
      duration-300.w-16
      + .flex-1
      p-6
      lg:p-8 {
      margin-left: var(--sidebar-w-16-width);
    }
    .mb-6 {
      height: var(--mb-6-height);
      border-bottom: 1px solid var(--color-border);
      background: var(--color-surface);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.5rem;
      position: sticky;
      top: 0;
      z-index: 20;
    }
    . {
      padding: 2rem;
    }
  </style>

  <!-- Sentry & Web Vitals Initialization -->
  <script>
    import { initSentry, initWebVitals } from '@lib/sentry';
    // Initialize Sentry (production only, handled by @sentry/astro integration)
    // This ensures client-side configuration
    if (import.meta.env.PROD) {
      initSentry();
      initWebVitals();
    }
  </script>

  <div class="min-h-screen bg-neutral-50 dark:bg-neutral-900">
    <Sidebar client:visible />

    <main class="flex-1 p-6 lg:p-8">
      <header class="mb-6">
        <h1 class="font-sans text-xl font-semibold text-text-primary">Administración</h1>
        <div class="flex items-center gap-4">
          <span class="hidden text-sm text-text-secondary sm:block" id="user-email"></span>
        </div>
      </header>
      <div class="">
        <slot />
      </div>
    </main>
  </div>

  <script>
    // Update user email from auth context if available
    const userEmail = document.getElementById('user-email');
    if (userEmail && window.__AUTH_USER__) {
      userEmail.textContent = window.__AUTH_USER__.email;
    }
  </script>
</Layout>
