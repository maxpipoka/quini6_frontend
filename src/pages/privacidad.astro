---
/**
 * Privacy Policy Page - Info Quini 6
 * Transparent disclosure of what data we collect, how we use it, and user rights
 */

import Layout from '../layouts/Layout.astro';
import { Header, Footer, Container } from '../components/layout';
---

<Layout
  title="Política de Privacidad"
  description="Política de privacidad de Info Quini 6. Qué datos recopilamos, cómo los usamos y tus derechos sobre ellos."
>
  <Header currentPath="/privacidad" />

  <main id="main-content" role="main">
    <section class="bg-surface py-12 md:py-16" aria-labelledby="privacy-heading">
      <Container maxWidth="prose">
        <header class="mb-12 text-center">
          <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-primary-600 dark:text-primary-400">
            Privacidad
          </p>
          <h1
            id="privacy-heading"
            class="font-sans text-display-sm text-text-primary md:text-display-md"
          >
            Política de Privacidad
          </h1>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-text-secondary">
            Última actualización: {
              new Date().toLocaleDateString('es-AR', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })
            }
          </p>
        </header>

        <article class="policy-article">
          <!-- 1. Resumen ejecutivo -->
          <section class="policy-section">
            <h2 class="policy-title">1. Resumen ejecutivo</h2>
            <div
              class="mb-4 rounded-lg border-l-4 border-success-500 bg-success-50 p-4 dark:bg-success-700/20"
            >
              <p class="font-medium text-success-700 dark:text-success-400">
                No vendemos tus datos. No construimos perfiles publicitarios. No compartimos
                información con terceros para marketing.
              </p>
            </div>
            <p class="policy-text">
              Info Quini 6 es un sitio de consulta pública de resultados del Quini 6 (Lotería de
              Santa Fe). No requiere registro de usuarios para acceder a su contenido.
            </p>
          </section>

          <!-- 2. Responsable del tratamiento -->
          <section class="policy-section">
            <h2 class="policy-title">2. Responsable del tratamiento</h2>
            <div class="policy-callout">
              <p>
                <strong>Responsable:</strong> Info Quini 6<br />
                <strong>Email de contacto:</strong>
                <a href="mailto:privacidad@infoquini6.com">privacidad@infoquini6.com</a><br />
                <strong>Fuente de datos:</strong> Lotería de Santa Fe (resultados oficiales
                públicos)
              </p>
            </div>
          </section>

          <!-- 3. Qué datos tratamos -->
          <section class="policy-section">
            <h2 class="policy-title">3. Qué datos tratamos</h2>

            <h3 class="policy-subtitle">3.1 Datos que NO recopilamos</h3>
            <ul class="policy-list policy-list-no">
              <li>No pedimos nombre, email ni datos personales para usar el sitio</li>
              <li>No usamos formularios de registro en páginas públicas</li>
              <li>No compramos ni enriquecemos datos con terceros</li>
              <li>No usamos cookies de publicidad ni de seguimiento</li>
            </ul>

            <h3 class="policy-subtitle">3.2 Datos que sí tratamos</h3>
            <div class="policy-table-wrapper">
              <table class="policy-table">
                <thead>
                  <tr>
                    <th>Dato</th>
                    <th>Cómo se obtiene</th>
                    <th>Finalidad</th>
                    <th>Base legal</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Páginas visitadas, referrers, país</td>
                    <td>Plausible Analytics (agregado, anónimo)</td>
                    <td>Mejorar el sitio y entender el uso</td>
                    <td>Interés legítimo</td>
                  </tr>
                  <tr>
                    <td>Preferencia de tema (claro/oscuro)</td>
                    <td>localStorage en tu navegador</td>
                    <td>Recordar tu preferencia</td>
                    <td>Preferencia de usuario</td>
                  </tr>
                  <tr>
                    <td>Datos técnicos del servidor (logs)</td>
                    <td>Registros automáticos del hosting</td>
                    <td>Seguridad y diagnóstico de errores</td>
                    <td>Interés legítimo</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="policy-note">
              Consultá también nuestra
              <a href="/cookies">Política de Cookies</a> para el detalle completo de tecnologías.
            </p>
          </section>

          <!-- 4. Cómo usamos los datos -->
          <section class="policy-section">
            <h2 class="policy-title">4. Cómo usamos los datos</h2>
            <ul class="policy-list">
              <li>Mostrar resultados oficiales del Quini 6 de forma gratuita</li>
              <li>Mejorar la experiencia de navegación (preferencias, rendimiento)</li>
              <li>Proteger el sitio contra abuso y errores técnicos</li>
              <li>Generar estadísticas agregadas de tráfico (sin identificar personas)</li>
            </ul>
          </section>

          <!-- 5. Terceros -->
          <section class="policy-section">
            <h2 class="policy-title">5. Terceros con acceso a datos</h2>
            <div class="policy-table-wrapper">
              <table class="policy-table">
                <thead>
                  <tr>
                    <th>Tercero</th>
                    <th>Servicio</th>
                    <th>Datos</th>
                    <th>Ubicación</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Plausible</td>
                    <td>Analítica sin cookies</td>
                    <td>Tráfico agregado y anónimo</td>
                    <td>Unión Europea</td>
                  </tr>
                  <tr>
                    <td>Vercel</td>
                    <td>Hosting del sitio</td>
                    <td>Logs técnicos de servidor</td>
                    <td>EE.UU. (cláusulas contractuales)</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="policy-note">
              <em>No vendemos ni cedemos datos a otros terceros.</em>
            </p>
          </section>

          <!-- 6. Conservación -->
          <section class="policy-section">
            <h2 class="policy-title">6. Conservación de datos</h2>
            <ul class="policy-list">
              <li><strong>Analítica:</strong> datos agregados, sin plazo de eliminación individual</li>
              <li><strong>Logs del servidor:</strong> eliminados o anonimizados en plazo razonable</li>
              <li><strong>localStorage:</strong> solo en tu dispositivo, borrás con tu navegador</li>
            </ul>
          </section>

          <!-- 7. Derechos -->
          <section class="policy-section">
            <h2 class="policy-title">7. Tus derechos</h2>
            <p class="policy-text">
              Bajo GDPR (UE) y Ley 25.326 (Argentina), tenés derecho a:
            </p>
            <ul class="policy-list policy-list-rights">
              <li><strong>Acceder</strong> a qué datos tuyos tratamos</li>
              <li><strong>Rectificar</strong> datos inexactos</li>
              <li><strong>Suprimir</strong> ("derecho al olvido")</li>
              <li><strong>Oponerte</strong> al tratamiento por interés legítimo</li>
              <li><strong>Portabilidad</strong> de tus datos</li>
              <li><strong>Retirar consentimiento</strong> cuando sea la base legal</li>
              <li><strong>Reclamar</strong> ante la autoridad de control</li>
            </ul>
            <div class="policy-callout">
              <p>
                Para ejercerlos: <a href="mailto:privacidad@infoquini6.com"
                  >privacidad@infoquini6.com</a
                >
              </p>
            </div>
          </section>

          <!-- 8. Seguridad -->
          <section class="policy-section">
            <h2 class="policy-title">8. Seguridad</h2>
            <p class="policy-text">
              Aplicamos medidas técnicas y organizativas razonables: HTTPS, protección CSRF,
              acceso restringido al panel de administración y revisión de dependencias. Ningún
              sistema es 100% seguro, pero trabajamos para minimizar riesgos.
            </p>
          </section>

          <!-- 9. Menores -->
          <section class="policy-section">
            <h2 class="policy-title">9. Menores de edad</h2>
            <p class="policy-text">
              El sitio es de consulta pública y no recopila datos personales. No obstante, no
              está dirigido a menores de 13 años.
            </p>
          </section>

          <!-- 10. Cambios -->
          <section class="policy-section">
            <h2 class="policy-title">10. Cambios en esta política</h2>
            <p class="policy-text">
              Cualquier cambio se publicará en esta página con nueva fecha de "Última
              actualización". Los cambios relevantes se comunicarán de forma destacada.
            </p>
          </section>

          <!-- 11. Contacto -->
          <section class="policy-section">
            <h2 class="policy-title">11. Contacto</h2>
            <div class="policy-callout">
              <p>
                <strong>Responsable:</strong> Info Quini 6<br />
                <strong>Email:</strong>
                <a href="mailto:privacidad@infoquini6.com">privacidad@infoquini6.com</a><br />
                <strong>Documentos relacionados:</strong>
                <a href="/cookies">Política de Cookies</a> ·
                <a href="/terminos">Términos de Uso</a>
              </p>
            </div>
          </section>
        </article>
      </Container>
    </section>
  </main>

  <Footer showAdmin={false} />
</Layout>

<style>
  /* ===== Article layout ===== */
  .policy-article {
    line-height: 1.7;
  }

  .policy-section {
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-border, #e5e7eb);
  }

  .policy-section:last-child {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  /* ===== Headings ===== */
  .policy-title {
    font-family: var(--font-sans, system-ui);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary, #111827);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .policy-subtitle {
    font-family: var(--font-sans, system-ui);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary, #374151);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  /* ===== Text ===== */
  .policy-text {
    margin-bottom: 1rem;
    color: var(--color-text-secondary, #4b5563);
  }

  .policy-note {
    font-size: 0.875rem;
    color: var(--color-text-muted, #9ca3af);
    margin-top: 0.5rem;
  }

  /* ===== Lists ===== */
  .policy-list {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 1rem;
  }

  .policy-list li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-text-secondary, #4b5563);
  }

  .policy-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-primary-500, #3b82f6);
    font-weight: 700;
  }

  .policy-list-no li::before {
    content: '✕';
    color: var(--color-error-500, #ef4444);
  }

  .policy-list-rights li::before {
    content: '→';
    color: var(--color-primary-500, #3b82f6);
  }

  /* ===== Callout ===== */
  .policy-callout {
    background: var(--color-surface-elevated, #f9fafb);
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
  }

  .policy-callout p {
    margin: 0;
    color: var(--color-text-secondary, #4b5563);
  }

  /* ===== Tables ===== */
  .policy-table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .policy-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .policy-table th {
    background: var(--color-surface-elevated, #f3f4f6);
    font-weight: 600;
    color: var(--color-text-primary, #111827);
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 2px solid var(--color-border, #e5e7eb);
  }

  .policy-table td {
    padding: 0.75rem 1rem;
    color: var(--color-text-secondary, #4b5563);
    border-bottom: 1px solid var(--color-border, #f3f4f6);
    vertical-align: top;
  }

  .policy-table tr:last-child td {
    border-bottom: none;
  }

  /* ===== Code ===== */
  :global(.policy-article) code {
    background: var(--color-surface-elevated, #f3f4f6);
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 0.25rem;
    padding: 0.125rem 0.375rem;
    font-size: 0.85em;
    font-family: 'SF Mono', 'Fira Code', monospace;
  }

  /* ===== Links ===== */
  :global(.policy-article) a {
    color: var(--color-primary-600, #2563eb);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }

  :global(.policy-article) a:hover {
    color: var(--color-primary-700, #1d4ed8);
  }

  /* ===== Responsive ===== */
  @media (max-width: 640px) {
    .policy-title {
      font-size: 1.25rem;
    }

    .policy-subtitle {
      font-size: 1rem;
    }
  }
</style>