---
// Test fixture page for FileDropzone visual regression
import FileDropzone from '@/components/ui/FileDropzone';
import { sampleProps } from '@tests/e2e/fixtures/visual-test-data';

const { state = 'default' } = Astro.url.searchParams;
const props = sampleProps.FileDropzone[state as keyof typeof sampleProps.FileDropzone] ?? sampleProps.FileDropzone.default;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Visual Test: FileDropzone - {state}</title>
    <style>
      /* Disable animations for consistent screenshots */
      [data-test-animate="false"],
      [data-test-animate="false"] *,
      [data-test-animate="false"] *::before,
      [data-test-animate="false"] *::after {
        animation-duration: 0s !important;
        animation-delay: -1ms !important;
        transition-duration: 0s !important;
        transition-delay: -1ms !important;
      }
    </style>
  </head>
  <body data-test-animate="false" class="min-h-screen p-8 bg-neutral-50 dark:bg-neutral-900">
    <main>
      <h1 class="sr-only">FileDropzone Component Test</h1>
      <FileDropzone {...props} client:load />
    </main>
  </body>
</html>