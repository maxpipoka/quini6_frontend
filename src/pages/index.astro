---
/**
 * Home Page - Landing page with hero, featured draw, recent draws, and CTA
 * Features: Hero, Featured Card (Último sorteo), Recent Draws (5 previous), CTA to /buscar
 * Uses design tokens from global.css
 */

import Layout from '../layouts/Layout.astro';
import { Header, Footer, Container } from '../components/layout';
import { getApiClient } from '../lib/api/client';
import type { DrawSummary } from '../lib/schemas';
import NumberBall from '../components/draws/NumberBall.tsx';
import Button from '../components/ui/Button.astro';
import Spinner from '../components/ui/Spinner.astro';

interface DrawLike {
  id: string;
  officialNumber: number;
  drawDate: string;
  results: { modality: string; numbers: number[] }[];
}

// Mock data for build-time static generation when API is not available
const MOCK_DRAWS: DrawLike[] = Array.from({ length: 30 }, (_, index) => {
  const drawDate = new Date(Date.UTC(2024, 5, 1) - index * 7 * 24 * 60 * 60 * 1000).toISOString();
  const MODALITIES = ['TRADICIONAL', 'LA_SEGUNDA', 'REVANCHA', 'SIEMPRE_SALE'];
  return {
    id: `mock-${index}`,
    officialNumber: 3245 - index,
    drawDate,
    createdAt: drawDate,
    updatedAt: drawDate,
    results: MODALITIES.map((modality, modalityIndex) => ({
      modality,
      numbers: Array.from({ length: 6 }, (_, k) => (index * 3 + modalityIndex * 7 + k * 5) % 46),
      createdAt: drawDate,
      updatedAt: drawDate,
    })),
  };
});

function toSummary(draw: DrawLike): DrawSummary {
  return {
    id: draw.id,
    officialNumber: draw.officialNumber,
    drawDate: draw.drawDate,
    results: draw.results.map(({ modality, numbers }) => ({ modality, numbers })),
  };
}

// Fetch latest draw with mock fallback
let latestDraw: DrawSummary | null = null;
let latestDrawError: unknown = null;

try {
  const apiClient = getApiClient();
  latestDraw = await apiClient.getLatestDraw();
} catch (error) {
  console.warn('Could not fetch latest draw from API, using mock data:', error);
  latestDrawError = null;
  latestDraw = toSummary(MOCK_DRAWS[0]);
}

// Fetch recent draws (5 previous, excluding the latest) with mock fallback
let recentDraws: DrawSummary[] | null = null;
let recentDrawsError: unknown = null;

try {
  const apiClient = getApiClient();
  const response = await apiClient.getDrawHistory({ page: 1, limit: 5 });
  recentDraws = response.data;
} catch (error) {
  console.warn('Could not fetch recent draws from API, using mock data:', error);
  recentDrawsError = null;
  recentDraws = MOCK_DRAWS.slice(1, 6).map(toSummary);
}

const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString('es-AR', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
};

const formatShortDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString('es-AR', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  });
};

const MODALITY_LABELS: Record<string, string> = {
  TRADICIONAL: 'Tradicional',
  LA_SEGUNDA: 'La Segunda',
  REVANCHA: 'Revancha',
  SIEMPRE_SALE: 'Siempre Sale',
};

const MODALITY_COLORS: Record<string, 'primary' | 'secondary' | 'success' | 'warning'> = {
  TRADICIONAL: 'primary',
  LA_SEGUNDA: 'secondary',
  REVANCHA: 'success',
  SIEMPRE_SALE: 'warning',
};
---

<Layout
  title="Inicio"
  description="Resultados y estadísticas del Quini 6 - Consulte el último sorteo, historial completo y busque sus números favoritos."
>
  <Header currentPath="/" />

  <main id="main-content" role="main">
    <!-- Hero Section -->
    <section
      class="bg-gradient-to-b from-primary-50 to-transparent py-16 md:py-24 dark:from-[rgba(59,130,246,0.1)]"
    >
      <Container maxWidth="lg">
        <div class="mx-auto max-w-3xl text-center">
          <h1 class="mb-6 font-sans text-display-md text-text-primary">
            Resultados y estadísticas del <span class="text-primary-600">Quini 6</span>
          </h1>
          <p class="mb-8 text-lg text-text-secondary">
            Consulte sorteos históricos, busque sus combinaciones favoritas y analice la frecuencia
            de los números. Datos oficiales actualizados.
          </p>
          <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
            <Button href="/buscar" size="lg" variant="primary"> Buscar mi combinación </Button>
            <Button href="/sorteos" size="lg" variant="ghost"> Ver historial completo </Button>
          </div>
        </div>
      </Container>
    </section>

    <!-- Featured Card: Último Sorteo -->
    <section class="py-12 md:py-16" aria-labelledby="latest-draw-heading">
      <Container maxWidth="lg">
        <div class="mb-8 flex items-center justify-between">
          <h2 id="latest-draw-heading" class="font-sans text-heading-xl text-text-primary">
            Último sorteo
          </h2>
          <a
            href="/sorteos"
            class="text-sm font-medium text-primary-600 transition-colors hover:text-primary-700"
          >
            Ver todos →
          </a>
        </div>

        {
          latestDrawError ? (
            <div class="card-elevated p-8 text-center" role="alert">
              <p class="mb-4 text-text-secondary">No pudimos cargar el último sorteo</p>
              <Button variant="ghost" href="/" aria-label="Reintentar carga">
                Reintentar
              </Button>
            </div>
          ) : latestDraw ? (
            <article class="card-elevated overflow-hidden">
              <div class="dark:bg-primary-900/20 border-b border-border bg-primary-50 p-6 md:p-8">
                <div class="flex flex-col items-start gap-2 md:flex-row md:items-center md:justify-between">
                  <div>
                    <p class="text-sm font-medium text-primary-700 dark:text-primary-300">
                      Sorteo Nº {latestDraw.officialNumber}
                    </p>
                    <p class="text-base text-text-secondary">{formatDate(latestDraw.drawDate)}</p>
                  </div>
                  <div class="flex items-center gap-3">
                    <span class="rounded-full bg-primary-100 px-3 py-1 text-xs font-semibold text-primary-700 dark:bg-primary-900 dark:text-primary-300">
                      OFICIAL
                    </span>
                  </div>
                </div>
              </div>

              <div class="p-6 md:p-8">
                <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
                  {latestDraw.results.map((result) => (
                    <div key={result.modality} class="flex flex-col items-center gap-3 text-center">
                      <span class="text-caption font-semibold uppercase tracking-wide text-text-secondary">
                        {MODALITY_LABELS[result.modality] ?? result.modality}
                      </span>
                      <div
                        class="flex gap-1.5"
                        role="img"
                        aria-label={`${MODALITY_LABELS[result.modality]}: ${result.numbers.map((n) => n.toString().padStart(2, '0')).join(', ')}`}
                      >
                        {result.numbers.map((num, idx) => (
                          <NumberBall
                            key={idx}
                            number={num}
                            size="lg"
                            variant={MODALITY_COLORS[result.modality] ?? 'primary'}
                          />
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </article>
          ) : (
            <div class="card-elevated p-12 text-center" role="status">
              <Spinner size="lg" color="primary" aria-label="Cargando último sorteo" />
              <p class="mt-4 text-text-secondary">Cargando último sorteo...</p>
            </div>
          )
        }
      </Container>
    </section>

    <!-- Recent Draws -->
    <section class="bg-surface py-12 md:py-16" aria-labelledby="recent-draws-heading">
      <Container maxWidth="lg">
        <div class="mb-8 flex items-center justify-between">
          <h2 id="recent-draws-heading" class="font-sans text-heading-xl text-text-primary">
            Sorteos recientes
          </h2>
          <a
            href="/sorteos"
            class="text-sm font-medium text-primary-600 transition-colors hover:text-primary-700"
          >
            Ver todos →
          </a>
        </div>

        {
          recentDrawsError ? (
            <div class="card-elevated p-8 text-center" role="alert">
              <p class="mb-4 text-text-secondary">No pudimos cargar los sorteos recientes</p>
              <Button variant="ghost" href="/" aria-label="Reintentar carga">
                Reintentar
              </Button>
            </div>
          ) : recentDraws ? (
            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {recentDraws.map((draw) => (
                <a
                  key={draw.id}
                  href={`/sorteos/${draw.officialNumber}`}
                  class="card-elevated block p-6 transition-shadow hover:shadow-lg"
                  aria-label={`Ver sorteo Nº ${draw.officialNumber} del ${formatShortDate(draw.drawDate)}`}
                >
                  <div class="mb-4 flex items-center justify-between">
                    <span class="text-sm font-semibold text-primary-600 dark:text-primary-400">
                      Sorteo Nº {draw.officialNumber}
                    </span>
                    <time class="text-caption text-text-muted" dateTime={draw.drawDate}>
                      {formatShortDate(draw.drawDate)}
                    </time>
                  </div>
                  <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
                    {draw.results.map((result) => (
                      <div
                        key={result.modality}
                        class="flex flex-col items-center gap-1.5 text-center"
                      >
                        <span class="text-[10px] font-medium uppercase tracking-wide text-text-muted">
                          {MODALITY_LABELS[result.modality] ?? result.modality}
                        </span>
                        <div
                          class="flex gap-0.5"
                          role="img"
                          aria-label={`${MODALITY_LABELS[result.modality]}: ${result.numbers.map((n) => n.toString().padStart(2, '0')).join(', ')}`}
                        >
                          {result.numbers.map((num, idx) => (
                            <NumberBall
                              key={idx}
                              number={num}
                              size="sm"
                              variant={MODALITY_COLORS[result.modality] ?? 'primary'}
                            />
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="card-elevated p-12 text-center" role="status">
              <Spinner size="lg" color="primary" aria-label="Cargando sorteos recientes" />
              <p class="mt-4 text-text-secondary">Cargando sorteos recientes...</p>
            </div>
          )
        }
      </Container>
    </section>

    <!-- CTA Section -->
    <section class="bg-primary-600 py-16 md:py-24" aria-labelledby="cta-heading">
      <Container maxWidth="lg">
        <div class="text-center text-white">
          <h2 id="cta-heading" class="mb-4 font-sans text-display-sm">
            ¿Quiere buscar una combinación específica?
          </h2>
          <p class="mx-auto mb-8 max-w-2xl text-lg text-primary-100">
            Ingrese sus 6 números y le mostraremos en qué sorteos han salido juntos, con todas las
            modalidades y fechas.
          </p>
          <Button href="/buscar" size="lg" variant="secondary"> Buscar combinación </Button>
        </div>
      </Container>
    </section>

    <!-- Ad Slot (Collapsible) -->
    <section class="py-8" aria-labelledby="ad-heading" role="complementary">
      <Container maxWidth="lg">
        <div
          id="ad-slot-top"
          class="flex aspect-video items-center justify-center rounded-lg bg-neutral-100 dark:bg-neutral-800"
          role="region"
          aria-label="Espacio publicitario"
        >
          <div class="p-4 text-center">
            <p class="text-text-muted">Espacio publicitario (728×90)</p>
            <p class="mt-1 text-caption text-text-muted">Se colapsa si no hay anuncio</p>
          </div>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</Layout>
