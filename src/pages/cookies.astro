---
/**
 * Cookie Policy Page - Info Quini 6
 * Transparent disclosure of all cookies, localStorage, and tracking technologies used
 */

import Layout from '../layouts/Layout.astro';
import { Header, Footer, Container } from '../components/layout';
---

<Layout
  title="Política de Cookies"
  description="Política de cookies de Info Quini 6. Información transparente sobre qué datos almacenamos, para qué sirven y tus derechos."
>
  <Header currentPath="/cookies" />

  <main id="main-content" role="main">
    <section class="bg-surface py-12 md:py-16" aria-labelledby="cookies-heading">
      <Container maxWidth="prose">
        <header class="mb-12 text-center">
          <p
            class="mb-3 text-sm font-semibold uppercase tracking-widest text-primary-600 dark:text-primary-400"
          >
            Privacidad
          </p>
          <h1
            id="cookies-heading"
            class="font-sans text-display-sm text-text-primary md:text-display-md"
          >
            Política de Cookies
          </h1>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-text-secondary">
            Última actualización: {
              new Date().toLocaleDateString('es-AR', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })
            }
          </p>
        </header>

        <article class="policy-article">
          <!-- 1. Resumen ejecutivo -->
          <section class="policy-section">
            <h2 class="policy-title">1. Resumen ejecutivo</h2>
            <div
              class="dark:bg-success-700/20 mb-4 rounded-lg border-l-4 border-success-500 bg-success-50 p-4"
            >
              <p class="font-medium text-success-700 dark:text-success-400">
                No utilizamos cookies de seguimiento, publicidad ni análisis invasivos.
              </p>
            </div>
            <p class="policy-text">
              Solo empleamos tecnologías estrictamente necesarias para el funcionamiento del sitio y
              preferencias de usuario.
            </p>
            <ul class="policy-list">
              <li>No vendemos tus datos.</li>
              <li>No construimos perfiles publicitarios.</li>
              <li>No compartimos información con terceros para marketing.</li>
            </ul>
          </section>

          <!-- 2. Qué tecnologías usamos -->
          <section class="policy-section">
            <h2 class="policy-title">2. Qué tecnologías usamos</h2>

            <!-- 2.1 Cookies -->
            <h3 class="policy-subtitle">2.1 Cookies (sin consentimiento)</h3>
            <div class="policy-callout">
              <p>
                <strong>Los usuarios públicos no reciben cookies.</strong> Las cookies
                <code>admin_session</code> y <code>csrf_token</code> solo se usan en el panel de administración
                (<code>/admin/*</code>) para autenticación y seguridad. Si no accedés al admin, no
                se establece ninguna cookie.
              </p>
            </div>

            <!-- 2.2 localStorage -->
            <h3 class="policy-subtitle">2.2 Preferencias locales (localStorage)</h3>
            <p class="policy-text">
              Estos datos <strong>nunca salen de tu dispositivo</strong>. No se envían a nuestros
              servidores.
            </p>
            <div class="policy-table-wrapper">
              <table class="policy-table">
                <thead>
                  <tr>
                    <th>Clave</th>
                    <th>Finalidad</th>
                    <th>Base legal</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><code>theme</code></td>
                    <td>Recordar tu preferencia de tema claro/oscuro</td>
                    <td>Preferencia de usuario (ePrivacy)</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="policy-note">
              <em>
                Las claves <code>sidebar-collapsed</code> y <code>health-dashboard-history</code>
                solo se usan en el panel de administración y no afectan a usuarios públicos.
              </em>
            </p>

            <!-- 2.3 sessionStorage -->
            <h3 class="policy-subtitle">2.3 Sesión de navegación (sessionStorage)</h3>
            <div class="policy-table-wrapper">
              <table class="policy-table">
                <thead>
                  <tr>
                    <th>Clave</th>
                    <th>Finalidad</th>
                    <th>Duración</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><code>hasNavigated</code></td>
                    <td>Evitar mover el foco al título en la primera carga (accesibilidad)</td>
                    <td>Hasta cerrar la pestaña</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- 2.4 Plausible -->
            <h3 class="policy-subtitle">2.4 Analítica: Plausible (sin cookies)</h3>
            <p class="policy-text">
              Usamos <a href="https://plausible.io" target="_blank" rel="noopener noreferrer"
                >Plausible Analytics</a
              >, una alternativa a Google Analytics sin cookies y compatible con GDPR/ePrivacy.
            </p>
            <ul class="policy-list">
              <li>No usa cookies ni localStorage</li>
              <li>No recopila datos personales ni IP completas (hash anónimo)</li>
              <li>No rastrea entre sitios</li>
              <li>Datos agregados: páginas vistas, referrers, país aproximado</li>
              <li>Alojado en UE, sin transferencia de datos fuera</li>
            </ul>
            <p class="policy-note">
              <strong>Base legal:</strong> interés legítimo (mejora del sitio). No requiere consentimiento
              previo.
            </p>
          </section>

          <!-- 3. Qué NO usamos -->
          <section class="policy-section">
            <h2 class="policy-title">3. Qué no usamos</h2>
            <ul class="policy-list policy-list-no">
              <li>Cookies de publicidad (AdSense, DoubleClick, Meta Pixel, etc.)</li>
              <li>Cookies de analítica con seguimiento personal (Google Analytics, etc.)</li>
              <li>Cookies de redes sociales (botones "Like", "Share" con tracking)</li>
              <li>Fingerprinting o canvas fingerprinting</li>
              <li>Terceros que construyan perfiles de usuario</li>
            </ul>
          </section>

          <!-- 4. Espacio publicitario -->
          <section class="policy-section">
            <h2 class="policy-title">4. Espacio publicitario (futuro)</h2>
            <div class="policy-callout">
              <p>
                El sitio incluye un slot para anuncios (placeholder en la home).
                <strong>Actualmente no hay ninguna red de publicidad activa.</strong> Si en el futuro
                se integrara una, se implementará:
              </p>
            </div>
            <ul class="policy-list">
              <li>Banner de consentimiento (CMP) previo a la carga de anuncios</li>
              <li>Opción de rechazar cookies publicitarias</li>
              <li>Actualización de esta política</li>
            </ul>
          </section>

          <!-- 5. Tus derechos -->
          <section class="policy-section">
            <h2 class="policy-title">5. Tus derechos</h2>
            <p class="policy-text">Bajo GDPR (UE) y Ley 25.326 (Argentina), tenés derecho a:</p>
            <ul class="policy-list policy-list-rights">
              <li><strong>Acceder</strong> a qué datos tuyos tratamos</li>
              <li><strong>Rectificar</strong> datos inexactos</li>
              <li><strong>Suprimir</strong> ("derecho al olvido")</li>
              <li><strong>Oponerte</strong> al tratamiento por interés legítimo</li>
              <li><strong>Portabilidad</strong> de tus datos</li>
              <li><strong>Retirar consentimiento</strong> cuando sea la base legal</li>
            </ul>
            <div class="policy-callout">
              <p>
                Para ejercerlos: <a href="mailto:privacidad@infoquini6.com"
                  >privacidad@infoquini6.com</a
                >
              </p>
            </div>
          </section>

          <!-- 6. Cómo gestionar/borrar -->
          <section class="policy-section">
            <h2 class="policy-title">6. Cómo gestionar estos datos</h2>
            <p class="policy-text">Para borrar las datos guardados en tu navegador:</p>
            <div class="policy-table-wrapper">
              <table class="policy-table">
                <thead>
                  <tr>
                    <th>Navegador</th>
                    <th>Atajo / Ruta</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Chrome</td>
                    <td><kbd>Ctrl+Shift+Delete</kbd></td>
                  </tr>
                  <tr>
                    <td>Firefox</td>
                    <td><kbd>Ctrl+Shift+Delete</kbd></td>
                  </tr>
                  <tr>
                    <td>Safari</td>
                    <td>Preferencias → Privacidad → Gestionar datos</td>
                  </tr>
                  <tr>
                    <td>Edge</td>
                    <td><kbd>Ctrl+Shift+Delete</kbd></td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="policy-note">
              También podés cambiar el tema con el botón 🌙/☀️ en la cabecera; eso actualiza
              <code>theme</code> automáticamente.
            </p>
          </section>

          <!-- 7. Cambios -->
          <section class="policy-section">
            <h2 class="policy-title">7. Cambios en esta política</h2>
            <p class="policy-text">
              Cualquier cambio se publicará en esta página con nueva fecha de "Última
              actualización". Si implica nuevo consentimiento (ej. ads), se mostrará un banner
              solicitándolo.
            </p>
          </section>

          <!-- 8. Contacto -->
          <section class="policy-section">
            <h2 class="policy-title">8. Contacto</h2>
            <div class="policy-callout">
              <p>
                <strong>Responsable:</strong> Info Quini 6<br />
                <strong>Email:</strong>
                <a href="mailto:privacidad@infoquini6.com">privacidad@infoquini6.com</a><br />
                <strong>Datos oficiales:</strong> Lotería de Santa Fe (resultados públicos)
              </p>
            </div>
          </section>
        </article>
      </Container>
    </section>
  </main>

  <Footer showAdmin={false} />
</Layout>

<style>
  /* ===== Article layout ===== */
  .policy-article {
    line-height: 1.7;
  }

  .policy-section {
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-border, #e5e7eb);
  }

  .policy-section:last-child {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  /* ===== Headings ===== */
  .policy-title {
    font-family: var(--font-sans, system-ui);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary, #111827);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .policy-subtitle {
    font-family: var(--font-sans, system-ui);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary, #374151);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  /* ===== Text ===== */
  .policy-text {
    margin-bottom: 1rem;
    color: var(--color-text-secondary, #4b5563);
  }

  .policy-note {
    font-size: 0.875rem;
    color: var(--color-text-muted, #9ca3af);
    margin-top: 0.5rem;
  }

  /* ===== Lists ===== */
  .policy-list {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 1rem;
  }

  .policy-list li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-text-secondary, #4b5563);
  }

  .policy-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-primary-500, #3b82f6);
    font-weight: 700;
  }

  .policy-list-no li::before {
    content: '✕';
    color: var(--color-error-500, #ef4444);
  }

  .policy-list-rights li::before {
    content: '→';
    color: var(--color-primary-500, #3b82f6);
  }

  /* ===== Callout / success banner ===== */
  .policy-callout {
    background: var(--color-surface-elevated, #f9fafb);
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
  }

  .policy-callout p {
    margin: 0;
    color: var(--color-text-secondary, #4b5563);
  }

  /* ===== Tables ===== */
  .policy-table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .policy-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .policy-table th {
    background: var(--color-surface-elevated, #f3f4f6);
    font-weight: 600;
    color: var(--color-text-primary, #111827);
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 2px solid var(--color-border, #e5e7eb);
  }

  .policy-table td {
    padding: 0.75rem 1rem;
    color: var(--color-text-secondary, #4b5563);
    border-bottom: 1px solid var(--color-border, #f3f4f6);
    vertical-align: top;
  }

  .policy-table tr:last-child td {
    border-bottom: none;
  }

  /* ===== Code & kbd ===== */
  :global(.policy-article) code {
    background: var(--color-surface-elevated, #f3f4f6);
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 0.25rem;
    padding: 0.125rem 0.375rem;
    font-size: 0.85em;
    font-family: 'SF Mono', 'Fira Code', monospace;
  }

  :global(.policy-article) kbd {
    display: inline-block;
    background: var(--color-surface-elevated, #f3f4f6);
    border: 1px solid var(--color-border, #d1d5db);
    border-bottom-width: 2px;
    border-radius: 0.25rem;
    padding: 0.125rem 0.5rem;
    font-size: 0.8em;
    font-family: inherit;
    font-weight: 500;
  }

  /* ===== Links ===== */
  :global(.policy-article) a {
    color: var(--color-primary-600, #2563eb);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }

  :global(.policy-article) a:hover {
    color: var(--color-primary-700, #1d4ed8);
  }

  /* ===== Responsive ===== */
  @media (max-width: 640px) {
    .policy-title {
      font-size: 1.25rem;
    }

    .policy-subtitle {
      font-size: 1rem;
    }
  }
</style>
