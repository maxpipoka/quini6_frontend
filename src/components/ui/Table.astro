---
/**
 * Table - Responsive data table component
 * Features: columns, data, emptyState, loadingState, responsive (cards on mobile)
 * Uses design tokens from global.css (CSS custom properties)
 * Note: Interactive sorting requires a React island wrapper
 */

import Spinner from './Spinner.astro';

interface Column<T> {
  key: string;
  header: string;
  render?: (row: T, index: number) => string | { html: string };
  class?: string;
  align?: 'left' | 'center' | 'right';
}

interface Props<T> {
  columns: Column<T>[];
  data: T[];
  emptyState?: string;
  loadingState?: boolean;
  loadingText?: string;
  rowKey: string;
  'aria-label'?: string;
  'aria-describedby'?: string;
}

const {
  columns,
  data,
  emptyState = 'No hay datos disponibles',
  loadingState = false,
  loadingText = 'Cargando...',
  rowKey: _rowKey,
  'aria-label': ariaLabel,
  'aria-describedby': ariaDescribedBy,
} = Astro.props as Props<Record<string, unknown>>;

// When the caller supplies a tbody slot, this component renders the table shell
// and the page fills rows client-side (e.g. admin draws fetches data in the browser).
const hasTbodySlot = Astro.slots.has('tbody');

function getThClass(column: Column<Record<string, unknown>>) {
  let cls = 'text-text-secondary px-4 py-3 text-left text-sm font-semibold';
  if (column.align === 'center') cls += ' text-center';
  if (column.align === 'right') cls += ' text-right';
  if (column.class) cls += ` ${column.class}`;
  return cls;
}

function getTdClass(column: Column<Record<string, unknown>>) {
  let cls = 'text-text-primary px-4 py-3 text-sm';
  if (column.align === 'center') cls += ' text-center';
  if (column.align === 'right') cls += ' text-right';
  if (column.class) cls += ` ${column.class}`;
  return cls;
}

function getTrClass(rowIndex: number) {
  let cls = 'dark:hover:bg-neutral-800/50 transition-colors hover:bg-neutral-50';
  if (rowIndex % 2 === 1) cls += ' bg-neutral-50/50 dark:bg-neutral-800/30';
  return cls;
}

const headerRowClass = 'border-b border-border bg-neutral-50 dark:bg-neutral-800';
const tableClass = 'w-full border-collapse';
const loadingContainerClass = 'flex flex-col items-center justify-center py-12';
const loadingTextClass = 'mt-4 text-text-secondary';
const emptyContainerClass = 'py-12 text-center';
const emptyTextClass = 'text-text-secondary';
const mobileCardsContainerClass = 'space-y-3 p-4 lg:hidden';
const cardClass = 'card-elevated p-4';
const dlClass = 'space-y-3';
const cardItemClass = 'flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between';
const dtClass = 'text-sm font-medium text-text-secondary sm:w-1/3 sm:pr-4';
const ddClass = 'text-left text-sm text-text-primary sm:w-2/3 sm:text-right';
const desktopTableClass = 'hidden lg:block';
const regionClass = 'w-full overflow-x-auto';
---

<div class={regionClass} role="region" aria-label={ariaLabel} aria-describedby={ariaDescribedBy}>
  {
    loadingState && !hasTbodySlot ? (
      <div class={loadingContainerClass} role="status" aria-live="polite">
        <Spinner size="lg" color="primary" aria-label={loadingText} />
        <p class={loadingTextClass}>{loadingText}</p>
      </div>
    ) : data.length === 0 && !hasTbodySlot ? (
      <div class={emptyContainerClass}>
        <p class={emptyTextClass}>{emptyState}</p>
      </div>
    ) : (
      <div>
        <div class={hasTbodySlot ? '' : desktopTableClass}>
          <table class={tableClass}>
            <thead>
              <tr class={headerRowClass}>
                {columns.map((column) => (
                  <th class={getThClass(column)} data-scope="col">
                    {column.header}
                  </th>
                ))}
              </tr>
            </thead>
            {hasTbodySlot ? (
              <slot name="tbody" />
            ) : (
              <tbody class="divide-y divide-border">
                {data.map((row, rowIndex) => (
                  <tr class={getTrClass(rowIndex)}>
                    {columns.map((column) => {
                      const cellValue = row[column.key];
                      const rendered = column.render
                        ? column.render(row, rowIndex)
                        : (cellValue ?? '');
                      return (
                        <td class={getTdClass(column)} data-label={column.header}>
                          {typeof rendered === 'object' &&
                          rendered !== null &&
                          'html' in rendered ? (
                            <Fragment set:html={rendered.html} />
                          ) : (
                            rendered
                          )}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            )}
          </table>
        </div>

        <div class={mobileCardsContainerClass}>
          {data.map((row, rowIndex) => (
            <article class={cardClass} data-row-index={rowIndex}>
              <dl class={dlClass}>
                {columns.map((column) => {
                  const cellValue = row[column.key];
                  const rendered = column.render ? column.render(row, rowIndex) : (cellValue ?? '');
                  return (
                    <div class={cardItemClass}>
                      <dt class={dtClass}>{column.header}</dt>
                      <dd class={ddClass}>
                        {typeof rendered === 'object' && rendered !== null && 'html' in rendered ? (
                          <Fragment set:html={rendered.html} />
                        ) : (
                          rendered
                        )}
                      </dd>
                    </div>
                  );
                })}
              </dl>
            </article>
          ))}
        </div>
      </div>
    )
  }
</div>

<style>
  /* Table specific styles */
  table {
    font-variant-numeric: tabular-nums;
  }

  th {
    white-space: nowrap;
    user-select: none;
  }

  /* Focus styles for keyboard navigation */
  [role='region']:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
    border-radius: var(--radius-md);
  }

  /* High contrast mode */
  @media (forced-colors: active) {
    table {
      forced-color-adjust: none;
      border-color: CanvasText;
    }
    th {
      background-color: Canvas;
      border-color: CanvasText;
    }
    td {
      border-color: CanvasText;
    }
    tr:hover {
      background-color: Highlight;
      color: HighlightText;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    tr {
      transition: none;
    }
  }

  /* Print styles */
  @media print {
    .lg\:hidden {
      display: none !important;
    }
    .hidden\:lg\:block {
      display: table !important;
    }
  }
</style>
