text-sm text-[#5D6878] tabular-nums\" data-kid=\"1-2-6-2-1-1-2\" data-name=\"draw 3411 date label\">Dom. 18/10/2026</span><span class=\"text-[18px] text-[#5D6878]\" data-kid=\"1-2-6-2-1-1-3\" data-name=\"right chevron icon wrapper\"><i class=\"icon-chevron-right\" data-kid=\"1-2-6-2-1-1-3-1\" data-name=\"right chevron icon\"></i></span></a></li>\n<li data-kid=\"1-2-6-2-2\" data-name=\"draw 3410 list item\"><a class=\"grid grid-cols-[80px_1fr_20px] items-center min-h-14\" data-kid=\"1-2-6-2-2-1\" data-name=\"draw 3410 detail link row\" href=\"/sorteos/3410\"><span class=\"text-[15px] font-semibold tabular-nums\" data-kid=\"1-2-6-2-2-1-1\" data-name=\"draw 3410 number label\">N.º 3410</span><span class=\"text-sm text-[#5D6878] tabular-nums\" data-kid=\"1-2-6-2-2-1-2\" data-name=\"draw 3410 date label\">Mié. 14/10/2026</span><span class=\"text-[18px] text-[#5D6878]\" data-kid=\"1-2-6-2-2-1-3\" data-name=\"right chevron icon wrapper\"><i class=\"icon-chevron-right\" data-kid=\"1-2-6-2-2-1-3-1\" data-name=\"right chevron icon\"></i></span></a></li>\n<li data-kid=\"1-2-6-2-3\" data-name=\"draw 3409 list item\"><a class=\"grid grid-cols-[80px_1fr_20px] items-center min-h-14\" data-kid=\"1-2-6-2-3-1\" data-name=\"draw 3409 detail link row\" href=\"/sorteos/3409\"><span class=\"text-[15px] font-semibold tabular-nums\" data-kid=\"1-2-6-2-3-1-1\" data-name=\"draw 3409 number label\">N.º 3409</span><span class=\"text-sm text-[#5D6878] tabular-nums\" data-kid=\"1-2-6-2-3-1-2\" data-name=\"draw 3409 date label\">Dom. 11/10/2026</span><span class=\"text-[18px] text-[#5D6878]\" data-kid=\"1-2-6-2-3-1-3\" data-name=\"right chevron icon wrapper\"><i class=\"icon-chevron-right\" data-kid=\"1-2-6-2-3-1-3-1\" data-name=\"right chevron icon\"></i></span></a></li>\n<li data-kid=\"1-2-6-2-4\" data-name=\"draw 3408 list item\"><a class=\"grid grid-cols-[80px_1fr_20px] items-center min-h-14\" data-kid=\"1-2-6-2-4-1\" data-name=\"draw 3408 detail link row\" href=\"/sorteos/3408\"><span class=