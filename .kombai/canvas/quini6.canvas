      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"font-['Inter',sans-serif] bg-[#F5F7FA] text-[#182230] antialiased min-h-screen\" data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"bg-[#12345A]\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"max-w-[1152px] mx-auto h-16 flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"header content container\">\n<a class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"site logo link\" href=\"/\">\n<span class=\"size-8 rounded-full bg-white text-[#12345A] text-[15px] font-bold flex items-center justify-center\" data-kid=\"1-1-1-1-1\" data-name=\"logo letter badge\">6</span>\n<span class=\"text-[17px] font-bold text-white tracking-tight\" data-kid=\"1-1-1-1-2\" data-name=\"site brand name\">Quini 6 <span class=\"font-medium text-[#B8D4F5]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand subtitle text\">Estadísticas</span></span>\n</a>\n<nav aria-label=\"Principal\" class=\"flex items-center gap-1\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\">\n<a aria-current=\"page\" class=\"px-3 h-9 inline-flex items-center rounded-lg bg-white/10 text-[15px] font-semibold text-white\" data-kid=\"1-1-1-2-1\" data-name=\"home navigation link (active)\" href=\"/\">Inicio</a>\n<a class=\"px-3 h-9 inline-flex items-center rounded-lg text-[15px] font-medium text-[#D5E3F3] hover:text-white hover:bg-white/5\" data-kid=\"1-1-1-2-2\" data-name=\"lottery history navigation link\" href=\"/sorteos\">Historial de sorteos</a>\n<a class=\"px-3 h-9 inline-flex items-center rounded-lg text-[15px] font-medium text-[#D5E3F3] hover:text-white hover:bg-white/5\" data-kid=\"1-1-1-2-3\" data-name=\"about navigation link\" href=\"/acerca\">Acerca del sitio</a>\n<a class=\"ml-3 inline-flex items-center gap-2 h-10 px-4 rounded-