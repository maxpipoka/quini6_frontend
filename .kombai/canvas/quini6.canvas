      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"font-['Inter',sans-serif] bg-[#F5F7FA] text-[#182230] antialiased min-h-screen\" data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"bg-white border-b border-[#DCE3EB]\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"px-4 h-14 flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"header inner bar\">\n<a class=\"flex items-center gap-2\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"/\">\n<span class=\"size-8 rounded-full bg-[#12345A] text-white text-[15px] font-bold flex items-center justify-center\" data-kid=\"1-1-1-1-1\" data-name=\"brand monogram badge\">6</span>\n<span class=\"leading-[1.1]\" data-kid=\"1-1-1-1-2\" data-name=\"brand wordmark\"><span class=\"block text-[15px] font-bold text-[#12345A]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">Quini 6</span><span class=\"block text-[13px] font-medium text-[#174A8B]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand subtitle text\">Estadísticas</span></span>\n</a>\n<button aria-controls=\"menu\" aria-expanded=\"false\" class=\"h-10 px-3 inline-flex items-center gap-2 rounded-[10px] border border-[#DCE3EB] text-sm font-semibold text-[#12345A]\" data-kid=\"1-1-1-2\" data-name=\"menu toggle button\" type=\"button\"><span class=\"text-[18px] leading-none\" data-kid=\"1-1-1-2-1\" data-name=\"menu icon wrapper\"><i class=\"icon-menu\" data-kid=\"1-1-1-2-1-1\" data-name=\"hamburger menu icon\"></i></span>Menú</button>\n</div>\n</header>\n<main class=\"px-4\" data-kid=\"1-2\" data-name=\"main content area\">\n<section class=\"pt-6 pb-5\" data-kid=\"1-2-1\" data-name=\"hero intro section\">\n<h1 class=\"text-[26px] leading-[1.2] font-bold text-[#12345A] tracking-tight\" data-kid=\"1-2-1-1\" data-name=\"hero headline\">Resultados y estadísticas del Quini 6</h1>\n<p class=\"mt-2 text-[15px] text-[#5D6878] leading-relaxed\" data-kid=\"1-2-1-2\" data-name=\"hero description text\">Consultá los últimos sorteos, revisá el historial y buscá si una combinación exacta apareció en los resultados publicados.</p>\n<a class=\"mt-4 h-12 w-full inline-flex items-center justify-center gap-2 rounded-[10px] bg-[#174A8B] text-white text-[15px] font-semibold\" data-kid=\"1-2-1-3\" data-name=\"primary search call-to-action button\" href=\"/buscar\"><span class=\"text-[17px] leading-none\" data-kid=\"1-2-1-3-1\" data-name=\"search icon wrapper\"><i class=\"icon-search\" data-kid=\"1-2-1-3-1-1\" data-name=\"search magnifying glass icon\"></i></span>Buscar combinación</a>\n</section>\n<aside aria-label=\"Publicidad\" class=\"h-[60px] rounded-[10px] border border-dashed border-[#C9D3DF] bg-[#EEF2F6] flex items-center justify-center\" data-kid=\"1-2-2\" data-name=\"advertising placeholder banner\">\n<span class=\"text-xs font-medium text-[#5D6878]\" data-kid=\"1-2-2-1\" data-name=\"ad label text\">Publicidad</span>\n</aside>\n<section aria-labelledby=\"ultimo-m\" class=\"mt-5 bg-white border border-[#DCE3EB] rounded-xl\" data-kid=\"1-2-3\" data-name=\"latest draw card\">\n<div class=\"px-3 pt-4 pb-3.5 border-b border-[#E8EDF3]\" data-kid=\"1-2-3-1\" data-name=\"latest draw header\">\n<h2 class=\"text-xl font-bold text-[#12345A]\" data-kid=\"1-2-3-1-1\" data-name=\"latest draw title\" id=\"ultimo-m\">Último sorteo</h2>\n<p class=\"mt-1 text-sm text-[#3B4656]\" data-kid=\"1-2-3-1-2\" data-name=\"latest draw meta info\"><span class=\"font-semibold text-[#182230] tabular-nums\" data-kid=\"1-2-3-1-2-1\" data-name=\"draw number label\">Sorteo N.º 3412</span><br data-kid=\"1-2-3-1-2-2\" data-name=\"line break\"/><time data-kid=\"1-2-3-1-2-3\" data-name=\"draw date text\" datetime=\"2026-10-21\">Miércoles 21 de octubre de 2026</time></p>\n</div>\n<ul class=\"px-3 divide-y divide-[#E8EDF3]\" data-kid=\"1-2-3-2\" data-name=\"draw ca