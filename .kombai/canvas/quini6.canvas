n</tr>\n</thead>\n<tbody class=\"divide-y divide-[#E8EDF3]\" data-kid=\"1-2-5-1-2-2\" data-name=\"table body\">\n<tr class=\"h-14 hover:bg-white\" data-kid=\"1-2-5-1-2-2-1\" data-name=\"draw history row\"><td class=\"text-base font-semibold tabular-nums text-[#12345A]\" data-kid=\"1-2-5-1-2-2-1-1\" data-name=\"draw number cell\">N.º 3411</td><td class=\"text-[15px] text-[#3B4656] tabular-nums\" data-kid=\"1-2-5-1-2-2-1-2\" data-name=\"draw date cell\">Domingo 18/10/2026</td><td class=\"text-right\" data-kid=\"1-2-5-1-2-2-1-3\" data-name=\"view results cell\"><a aria-label=\"Ver resultados del sorteo N.º 3411\" class=\"inline-flex items-center gap-1 text-sm font-semibold text-[#174A8B] hover:underline underline-offset-4\" data-kid=\"1-2-5-1-2-2-1-3-1\" data-name=\"view results link\" href=\"/sorteos/3411\">Ver resultados<span class=\"text-[15px] leading-none\" data-kid=\"1-2-5-1-2-2-1-3-1-1\" data-name=\"chevron icon container\"><i class=\"icon-chevron-right\" data-kid=\"1-2-5-1-2-2-1-3-1-1-1\" data-name=\"right chevron icon\"></i></span></a></td></tr>\n<tr class=\"h-14 hover:bg-white\" data-kid=\"1-2-5-1-2-2-2\" data-name=\"draw history row\"><td class=\"text-base font-semibold tabular-nums text-[#12345A]\" data-kid=\"1-2-5-1-2-2-2-1\" data-name=\"draw number cell\">N.º 3410</td><td class=\"text-[15px] text-[#3B4656] tabular-nums\" data-kid=\"1-2-5-1-2-2-2-2\" data-name=\"draw date cell\">Miércoles 14/10/2026</td><td class=\"text-right\" data-kid=\"1-2-5-1-2-2-2-3\" data-name=\"view results cell\"><a aria-label=\"Ver resultados del sorteo N.º 3410\" class=\"inline-flex items-center gap-1 text-sm font-semibold text-[#174A8B] hover:underline underline-offset-4\" data-kid=\"1-2-5-1-2-2-2-3-1\" data-name=\"view results link\" href=\"/sorteos/3410\">Ver resultados<span class=\"text-[15px] leading-none\" data-kid=\"1-2-5-1-2-2-2-3-1-1\" data-name=\"chevron icon container\"><i class=\"icon-chevron-right\" data-kid=\"1-2-5-1-2-2-2-3-1-1-1\" data-name=\"right chevron icon\">