      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"font-['Inter',sans-serif] bg-[#F5F7FA] text-[#182230] antialiased min-h-screen\" data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"bg-white border-b border-[#DCE3EB]\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"px-4 h-14 flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"header inner layout container\">\n<a class=\"flex items-center gap-2\" data-kid=\"1-1-1-1\" data-name=\"site brand logo link\" href=\"/\">\n<span class=\"size-8 rounded-full bg-[#12345A] text-white text-[15px] font-bold flex items-center justify-center\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo badge with number 6\">6</span>\n<span class=\"text-[16px] font-bold text-[#12345A]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">Quini 6 <span class=\"font-medium text-[#174A8B]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand accent subtitle text\">Estadísticas</span></span>\n</a>\n<button aria-expanded=\"false\" aria-label=\"Abrir menú\" class=\"size-11 inline-flex items-center justify-center rounded-[10px] border border-[#DCE3EB] text-[#12345A]\" data-kid=\"1-1-1-2\" data-name=\"mobile menu toggle button\" type=\"button\"><span class=\"text-[20px] leading-none\" data-kid=\"1-1-1-2-1\" data-name=\"menu icon wrapper\"><i class=\"icon-menu\" data-kid=\"1-1-1-2-1-1\" data-name=\"menu hamburger icon\"></i></span></button>\n</div>\n</header>\n<main class=\"px-4\" data-kid=\"1-2\" data-name=\"main content area\">\n<section class=\"pt-6 pb-5\" data-kid=\"1-2-1\" data-name=\"hero intro section\">\n<h1 class=\"text-[26px] leading-[1.2] font-bold text-[#12345A] tracking-tight\" data-kid=\"1-2-1-1\" data-name=\"hero headline text\">Resultados y estadísticas del Quini 6</h1>\n<p class=\"mt-2 text-[15px] text-[#5D6878] leading-relaxed\" data-kid=\"1-2-1-2\" data-name=\"hero description text\">Consultá los últimos sorteos, revisá el historial y buscá si una combinación exacta apareció en los resultados publicados.</p>\n<a class=\"mt-3 inline-flex items-center gap-1.5 min-h-11 text-[15px] font-semibold text-[#174A8B]\" data-kid=\"1-2-1-3\" data-name=\"search jump link\" href=\"#buscar\"><span class=\"text-[17px] leading-none\" data-kid=\"1-2-1-3-1\" data-name=\"search icon wrapper\"><i class=\"icon-search\" data-kid=\"1-2-1-3-1-1\" data-name=\"search magnifier icon\"></i></span>Buscar combinación<span class=\"text-[16px] leading-none\" data-kid=\"1-2-1-3-2\" data-name=\"down arrow icon wrapper\"><i class=\"icon-arrow-down\" data-kid=\"1-2-1-3-2-1\" data-name=\"down arrow icon\"></i></span></a>\n</section>\n<aside aria-label=\"Publicidad\" class=\"h-[60px] rounded-[10px] border border-dashed border-[#C9D3DF] bg-[#EEF2F6] flex items-center justify-center\" data-kid=\"1-2-2\" data-name=\"top advertisement placeholder\">\n<span class=\"text-xs font-medium text-[#5D6878]\" data-kid=\"1-2-2-1\" data-name=\"advertisement placeholder label\">Publicidad</span>\n</aside>\n<section aria-labelledby=\"ultimo-m\" class=\"mt-5 bg-white border border-[#DCE3EB] rounded-[14px]\" data-kid=\"1-2-3\" data-name=\"latest lottery result card\">\n<div class=\"px-4 pt-4 pb-3.5 border-b border-[#E8EDF3] flex items-start justify-between gap-3\" data-kid=\"1-2-3-1\" data-name=\"latest result card header\">\n<div data-kid=\"1-2-3-1-1\" data-name=\"latest result title block\">\n<h2 class=\"text-xl font-bold text-[#12345A]\" data-kid=\"1-2-3-1-1-1\" data-name=\"latest result section heading\" id=\"ultimo-m\">Último sorteo</h2>\n<p class=\"mt-1 text-sm text-[#3B4656]\" data-kid=\"1-2-3-1-1-2\" data-name=\"draw number and date meta line\"><span class=\"font-semibold text-[#182230] tabular-nums\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"draw number label\">N.º 3412</span> — <time data-kid=\"1-2-3-1-1-2-2\" data-name=\"draw date text