s-center justify-center\" data-kid=\"1-2-3-2-4-2-2\" data-name=\"drawn number ball 08\">08</li><li class=\"size-10 rounded-full bg-[#EAF4FF] text-[#12345A] text-[17px] font-semibold tabular-nums flex items-center justify-center\" data-kid=\"1-2-3-2-4-2-3\" data-name=\"drawn number ball 21\">21</li><li class=\"size-10 rounded-full bg-[#EAF4FF] text-[#12345A] text-[17px] font-semibold tabular-nums flex items-center justify-center\" data-kid=\"1-2-3-2-4-2-4\" data-name=\"drawn number ball 29\">29</li><li class=\"size-10 rounded-full bg-[#EAF4FF] text-[#12345A] text-[17px] font-semibold tabular-nums flex items-center justify-center\" data-kid=\"1-2-3-2-4-2-5\" data-name=\"drawn number ball 36\">36</li><li class=\"size-10 rounded-full bg-[#EAF4FF] text-[#12345A] text-[17px] font-semibold tabular-nums flex items-center justify-center\" data-kid=\"1-2-3-2-4-2-6\" data-name=\"drawn number ball 45\">45</li></ol></div>\n</div>\n</section>\n<aside aria-label=\"Publicidad\" class=\"mt-5 h-[100px] rounded-[10px] border border-dashed border-[#C9D3DF] bg-[#EEF2F6] flex items-center justify-center\" data-kid=\"1-2-4\" data-name=\"adsense advertisement placeholder\">\n<span class=\"text-xs font-medium text-[#5D6878]\" data-kid=\"1-2-4-1\" data-name=\"advertisement placeholder label\">Publicidad</span>\n</aside>\n<section aria-labelledby=\"buscar-t\" class=\"mt-5 bg-white border border-[#DCE3EB] rounded-[14px] p-4\" data-kid=\"1-2-5\" data-name=\"combination search card\" id=\"buscar\">\n<h2 class=\"text-xl font-bold text-[#12345A]\" data-kid=\"1-2-5-1\" data-name=\"combination search section heading\" id=\"buscar-t\">Buscá tu combinación</h2>\n<p class=\"mt-1.5 text-sm text-[#3B4656] leading-relaxed\" data-kid=\"1-2-5-2\" data-name=\"combination search instruction text\">Ingresá seis números del 00 al 45 para comprobar si esa combinación exacta aparece en el historial.</p>\n<fieldset class=\"mt-4\" data-kid=\"1-2-5-3\" data-name=\"number inputs fieldset\">\n<legend class=\"sr-only\" data-kid=\"1-2-5-3-1\" data-name=\"screen-reader-only fieldset legend\">Seis números de la combinación</legend>\n<div class=\"flex gap-2\" data-kid=\"1-2-5-3-2\" data-name=\"six number input row\">\n<div class=\"flex flex-col items-center gap-1\" data-kid=\"1-2-5-3-2-1\" data-name=\"position 1 label and input column\"><label class=\"text-[13px] font-semibold text-[#5D6878]\" data-kid=\"1-2-5-3-2-1-1\" data-name=\"position 1 position label\" for=\"m1\">1</label><input aria-label=\"Número 1\" class=\"w-11 h-12 rounded-[10px] border border-[#B9C6D5] text-center text-xl font-semibold tabular-nums\" data-kid=\"1-2-5-3-2-1-2\" data-name=\"number input field position 1\" id=\"m1\" inputmode=\"numeric\" value=\"07\"/></div>\n<div class=\"flex flex-col items-center gap-1\" data-kid=\"1-2-5-3-2-2\" data-name=\"position 2 label and input column\"><label class=\"text-[13px] font-semibold text-[#5D6878]\" data-kid=\"1-2-5-3-2-2-1\" data-name=\"position 2 position label\" for=\"m2\">2</label><input aria-label=\"Número 2\" class=\"w-11 h-12 rounded-[10px] border border-[#B9C6D5] text-center text-xl font-semibold tabular-nums\" data-kid=\"1-2-5-3-2-2-2\" data-name=\"number input field position 2\" id=\"m2\" inputmode=\"numeric\" value=\"14\"/></div>\n<div class=\"flex flex-col items-center gap-1\" data-kid=\"1-2-5-3-2-3\" data-name=\"position 3 label and input column\"><label class=\"text-[13px] font-semibold text-[#5D6878]\" data-kid=\"1-2-5-3-2-3-1\" data-name=\"position 3 position label\" for=\"m3\">3</label><input aria-label=\"Número 3\" class=\"w-11 h-12 rounded-[10px] border border-[#B9C6D5] text-center text-xl font-semibold tabular-nums\" data-kid=\"1-2-5-3-2-3-2\" data-name=\"number input field position 3\" id=\"m3\" inputmode=\"numeric\" value=\"22\"/></div>\n<div class=\"flex flex-col items-center gap-1\" data-kid=\"1-2-5-3-2-4\" data-name=\"position 4 label and input column with error state\"><label class=\"text-[13px] font-semibold text-[#B42318]\" data-kid=\"1-2-5-3-2-4-1\" data-name=\"position 4 position label with error styling\" for=\"m4\">4</label><input aria-describedby=\"err4\" aria-invalid=\"true\" aria-label=\"Número 4\" class=\"w-11 h-12 rounded-[10px] border-2 border-[#B42318] bg-[#FEF3F2] text-center text-xl font-semibold tabular-nums text-[#B42318] ring-[3px] ring-[#B42318]/15\" data-kid=\"1-2-5-3-2-4-2\" data-name=\"number input field position 4 with duplicate error\" id=\"m4\" inputmode=\"numeric\" value=\"14\"/></div>\n<div class=\"flex flex-col items-center gap-1\" data-kid=\"1-2-5-3-2-5\" data-name=\"position 5 label and input column\"><label class=\"text-[13px] font-semibold text-[#5D6878]\" data-kid=\"1-2-5-3-2-5-1\" data-name=\"position 5 position label\" for=\"m5\">5</label><input aria-label=\"Número 5\" class=\"w-11 h-12 rounded-[10px] border border-[#B9C6D5] text-center text-xl font-semibold tabular-nums\" data-kid=\"1-2-5-3-2-5-2\" data-name=\"number input field position 5\" id=\"m5\" inputmode=\"numeric\" value=\"\"/></div>\n<div class=\"flex flex-col items-center gap-1\" data-kid=\"1-2-5-3-2-6\" data-name=\"position 6 label and input column\"><label class=\"text-[13px] font-semibold text-[#5D6878]\" data-kid=\"1-2-5-3-2-6-1\" data-name=\"position 6 position label\" for=\"m6\">6</label><input aria-label=\"Número 6\" class=\"w-11 h-12 rounded-[10px] border border-[#B9C6D5] text-center text-xl font-semibold tabular-nums\" data-kid=\"1-2-5-3-2-6-2\" data-name=\"number input field position 6\" id=\"m6\" inputmode=\"numeric\" value=\"\"/></div>\n</div>\n<p class=\"mt-3 flex gap-1.5 text-sm font-medium text-[#B42318]\" data-kid=\"1-2-5-3-3\" data-name=\"duplicate number validation error message\" id=\"err4\"><span class=\"text-[16px] leading-none mt-px\" data-kid=\"1-2-5-3-3-1\" data-name=\"error icon wrapper\"><i class=\"icon-circle-alert\" data-kid=\"1-2-5-3-3-1-1\" data-name=\"circle alert icon\"></i></span>El 14 ya está en el campo 2. Cambiá el número 4.</p>\n</fieldset>\n<button aria-disabled=\"true\" cla