{
  "name": "quini6-frontend",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --ext .astro,.ts,.tsx,.js,.jsx,.md",
    "lint:fix": "eslint . --ext .astro,.ts,.tsx,.js,.jsx,.md --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test --project=visual --project=visual-mobile",
    "test:a11y": "playwright test --project=a11y --grep a11y",
    "test:visual:update": "playwright test --project=visual --project=visual-mobile --update-snapshots",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/tailwind": "^5.1.0",
    "@tanstack/react-table": "^9.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/uuid": "^11.0.0",
    "astro": "^5.0.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.0",
    "ky": "^1.2.0",
    "lucide-react": "^0.372.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "uuid": "^14.0.3",
    "xlsx": "^0.18.5",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.0",
    "@lhci/cli": "^0.13.0",
    "@playwright/test": "^1.43.0",
    "@storybook-astro/framework": "^1.13.0",
    "@storybook/addon-a11y": "^8.6.19",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/xlsx": "^0.0.36",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^1.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.2.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-storybook": "^10.6.4",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "husky": "^9.0.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^15.2.0",
    "msw": "^3.0.3",
    "prettier": "^3.2.0",
    "prettier-plugin-astro": "^0.13.0",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "storybook": "^8.6.14",
    "storybook-astro": "^0.2.1",
    "typescript": "^5.9.3",
    "vitest": "^1.4.0"
  }
}
