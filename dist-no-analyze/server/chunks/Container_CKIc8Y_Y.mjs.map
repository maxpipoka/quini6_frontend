---
/**
 * Header - Site header with logo, navigation, and mobile menu
 * Features: Logo (6 badge + "Quini 6 Estadísticas"), Nav links, Mobile hamburger menu with focus trap
 * Uses design tokens from global.css
 */

import NumberBall from '../draws/NumberBall.tsx';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-sticky border-b border-border bg-surface" role="banner">
  <div class="container-page">
    <div class="flex h-16 items-center justify-between md:h-20">
      <!-- Logo -->
      <a
        href="/"
        class="flex items-center gap-2 text-xl font-bold text-text-primary transition-opacity hover:opacity-80"
      >
        <NumberBall number={6} size="lg" variant="primary" class="shrink-0" />
        <span>Quini 6 Estadísticas</span>
      </a>

      <!-- Navigation -->
      <nav
        class="hidden items-center gap-6 md:flex"
        role="navigation"
        aria-label="Navegación principal"
      >
        <a
          href="/"
          class={`font-medium transition-colors ${
            currentPath === '/'
              ? 'text-text-primary'
              : 'text-text-secondary hover:text-text-primary'
          }`}
          aria-current={currentPath === '/' ? 'page' : undefined}
        >
          Inicio
        </a>
        <a
          href="/sorteos"
          class={`font-medium transition-colors ${
            currentPath.startsWith('/sorteos')
              ? 'text-text-primary'
              : 'text-text-secondary hover:text-text-primary'
          }`}
          aria-current={currentPath.startsWith('/sorteos') ? 'page' : undefined}
        >
          Historial de sorteos
        </a>
        <a
          href="/buscar"
          class={`font-medium transition-colors ${
            currentPath === '/buscar'
              ? 'text-text-primary'
              : 'text-text-secondary hover:text-text-primary'
          }`}
          aria-current={currentPath === '/buscar' ? 'page' : undefined}
        >
          Buscar combinación
        </a>
      </nav>

      <div class="flex items-center gap-2">
        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          type="button"
          class="rounded-lg p-2 text-text-secondary transition-colors hover:bg-neutral-100 hover:text-text-primary"
          aria-label="Cambiar tema"
          aria-pressed="false"
        >
          <svg
            class="size-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
        </button>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="rounded-lg p-2 text-text-secondary transition-colors hover:bg-neutral-100 hover:text-text-primary md:hidden"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            class="size-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="hidden border-t border-border py-4 md:hidden"
      role="navigation"
      aria-label="Menú móvil"
    >
      <nav class="flex flex-col gap-2">
        <a
          href="/"
          class={`rounded-lg px-4 py-2 font-medium transition-colors ${
            currentPath === '/'
              ? 'dark:bg-primary-900/20 bg-primary-50 text-primary-700 dark:text-primary-300'
              : 'text-text-secondary hover:bg-neutral-100 hover:text-text-primary'
          }`}
          aria-current={currentPath === '/' ? 'page' : undefined}
        >
          Inicio
        </a>
        <a
          href="/sorteos"
          class={`rounded-lg px-4 py-2 font-medium transition-colors ${
            currentPath.startsWith('/sorteos')
              ? 'dark:bg-primary-900/20 bg-primary-50 text-primary-700 dark:text-primary-300'
              : 'text-text-secondary hover:bg-neutral-100 hover:text-text-primary'
          }`}
          aria-current={currentPath.startsWith('/sorteos') ? 'page' : undefined}
        >
          Historial de sorteos
        </a>
        <a
          href="/buscar"
          class={`rounded-lg px-4 py-2 font-medium transition-colors ${
            currentPath === '/buscar'
              ? 'dark:bg-primary-900/20 bg-primary-50 text-primary-700 dark:text-primary-300'
              : 'text-text-secondary hover:bg-neutral-100 hover:text-text-primary'
          }`}
          aria-current={currentPath === '/buscar' ? 'page' : undefined}
        >
          Buscar combinación
        </a>
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  console.log('[Header] SCRIPT START - TOP OF SCRIPT');
  // Focus trap utility - inlined from focus-trap.ts (is:inline doesn't support imports)
  function getFocusableElements(container) {
    const selector = [
      'button:not([disabled]):not([tabindex="-1"])',
      '[href]:not([disabled]):not([tabindex="-1"])',
      'input:not([disabled]):not([tabindex="-1"])',
      'select:not([disabled]):not([tabindex="-1"])',
      'textarea:not([disabled]):not([tabindex="-1"])',
      '[tabindex]:not([tabindex="-1"])',
      '[contenteditable="true"]:not([tabindex="-1"])',
    ].join(', ');

    const elements = Array.from(container.querySelectorAll(selector));

    // Filter out elements that are not visually focusable
    // In production: check offsetParent !== null
    // In test environments (jsdom): offsetParent is always null, so check computed style
    const isTestEnv = document.body?.offsetParent === null;

    return elements.filter((el) => {
      if (isTestEnv) {
        const style = window.getComputedStyle(el);
        return style.display !== 'none' && style.visibility !== 'hidden';
      }
      return el.offsetParent !== null;
    });
  }

  function trapFocus(options) {
    const { container, onEscape, onClose } = options;
    let previouslyFocusedElement = null;
    let focusableElements = [];

    function updateFocusableElements() {
      focusableElements = getFocusableElements(container);
    }

    function handleKeydown(event) {
      // Handle Escape key
      if (event.key === 'Escape' && onEscape) {
        event.preventDefault();
        onEscape();
        return;
      }

      // Handle Tab cycling
      if (event.key !== 'Tab') return;

      updateFocusableElements();

      const firstElement = focusableElements[0];
      const lastElement = focusableElements[focusableElements.length - 1];

      if (!firstElement || !lastElement) return;

      if (event.shiftKey) {
        // Shift+Tab: moving backwards
        if (document.activeElement === firstElement) {
          event.preventDefault();
          lastElement.focus();
        }
      } else {
        // Tab: moving forwards
        if (document.activeElement === lastElement) {
          event.preventDefault();
          firstElement.focus();
        }
      }
    }

    function initialize() {
      // Store previously focused element
      previouslyFocusedElement = document.activeElement;

      // Get initial focusable elements
      updateFocusableElements();

      // Focus first focusable element
      const firstFocusable = focusableElements[0];
      firstFocusable?.focus();

      // Add event listeners
      document.addEventListener('keydown', handleKeydown);
    }

    function cleanup() {
      document.removeEventListener('keydown', handleKeydown);

      // Return focus to previously focused element
      previouslyFocusedElement?.focus();
      previouslyFocusedElement = null;
      focusableElements = [];

      onClose?.();
    }

    // Initialize immediately
    initialize();

    // Return cleanup function
    return cleanup;
  }

  function restoreFocus(element) {
    element?.focus();
  }

  console.log('[Header] Script loaded, adding DOMContentLoaded listener');
  console.log('[Header] Document readyState:', document.readyState);

  // Also log when script starts executing
  console.log('[Header] Script START executing');

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      console.log('[Header] DOMContentLoaded fired');
      initMobileMenu();
    });
  } else {
    console.log('[Header] DOM already loaded, calling initMobileMenu directly');
    initMobileMenu();
  }

  function initMobileMenu() {
    const menuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const themeToggle = document.getElementById('theme-toggle');
    console.log('[Header] initMobileMenu called');
    console.log('[Header] menuToggle:', menuToggle);
    console.log('[Header] mobileMenu:', mobileMenu);

    let cleanupFocusTrap: (() => void) | null = null;

    if (themeToggle) {
      const updateThemeIcon = (isDark: boolean) => {
        themeToggle.innerHTML = isDark
          ? '<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>'
          : '<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>';
        themeToggle.setAttribute('aria-pressed', String(isDark));
      };

      updateThemeIcon(document.documentElement.getAttribute('data-theme') === 'dark');

      themeToggle.addEventListener('click', () => {
        const html = document.documentElement;
        const isDark = html.getAttribute('data-theme') === 'dark';
        html.setAttribute('data-theme', isDark ? 'light' : 'dark');
        localStorage.setItem('theme', isDark ? 'light' : 'dark');
        updateThemeIcon(!isDark);
      });
    }

    if (menuToggle && mobileMenu) {
      console.log('[Header] Both menuToggle and mobileMenu found');
      const closeMenu = () => {
        mobileMenu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Abrir menú');
        if (cleanupFocusTrap) {
          cleanupFocusTrap();
          cleanupFocusTrap = null;
        }
      };

      const openMenu = () => {
        mobileMenu.classList.remove('hidden');
        menuToggle.setAttribute('aria-expanded', 'true');
        menuToggle.setAttribute('aria-label', 'Cerrar menú');

        // Activate focus trap
        cleanupFocusTrap = trapFocus({
          container: mobileMenu,
          onEscape: () => {
            closeMenu();
            restoreFocus(menuToggle);
          },
          onClose: () => {
            // Cleanup is handled by closeMenu
          },
        });

        // Focus first focusable element in menu
        const firstFocusable = mobileMenu.querySelector('a, button');
        firstFocusable?.focus();
      };

      menuToggle.addEventListener('click', () => {
        console.log('[Header] Menu toggle clicked');
        console.log('[Header] mobileMenu:', mobileMenu);
        console.log('[Header] mobileMenu.classList:', mobileMenu.classList);
        console.log(
          '[Header] mobileMenu.classList.contains(hidden):',
          mobileMenu.classList.contains('hidden')
        );
        const isOpen = mobileMenu.classList.contains('hidden');
        if (isOpen) {
          console.log('[Header] Opening menu');
          openMenu();
        } else {
          console.log('[Header] Closing menu');
          closeMenu();
          restoreFocus(menuToggle);
        }
      });

      // Close menu when clicking a link
      mobileMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          closeMenu();
          restoreFocus(menuToggle);
        });
      });
    }
  }
  initMobileMenu();
  // Expose for testing
  window.initMobileMenu = initMobileMenu;
  window.__headerScriptRan = true;
  console.log('[Header] initMobileMenu exposed on window');
  console.log('[Header] window.initMobileMenu:', window.initMobileMenu);
</script>

<style>
  /* High contrast mode */
  @media (forced-colors: active) {
    header {
      forced-color-adjust: none;
      border-color: CanvasText;
      background-color: Canvas;
    }
    nav a {
      color: LinkText;
      border-color: transparent;
    }
    nav a:hover,
    nav a:focus {
      color: HighlightText;
      background-color: Highlight;
    }
    nav a[aria-current='page'] {
      color: HighlightText;
      background-color: Highlight;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    a,
    button {
      transition: none;
    }
  }

  /* Focus visible for mobile menu items */
  #mobile-menu:not(.hidden) *:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
</style>
