---
/**
 * Search Page - Exact combination search
 * Features: 6 NumberInputs with Zod validation, primary/secondary actions,
 * loading/empty/error states with requestId. The form is a React island so it
 * owns the client-side fetch and result rendering.
 */

import Layout from '../layouts/Layout.astro';
import { Header, Footer, Container } from '../components/layout';
import SearchForm from '../components/search/SearchForm.tsx';

const apiBaseUrl = import.meta.env.VITE_API_BASE_URL;
---

<Layout
  title="Buscar combinación"
  description="Búsqueda exacta de combinaciones en el historial del Quini 6. Ingrese 6 números y descubra en qué sorteos han salido juntos."
  canonical="/buscar"
>
  <Header currentPath="/buscar" />

  <main id="main-content" role="main">
    <Container maxWidth="md" class="py-8 md:py-12">
      <header class="mb-8 text-center">
        <h1 class="font-sans text-display-sm text-text-primary">Buscar combinación</h1>
        <p class="mt-2 text-text-secondary">
          Ingrese 6 números (0-45) y le mostraremos todos los sorteos donde han salido juntos, en
          cualquier modalidad.
        </p>
      </header>

      <SearchForm client:load apiBaseUrl={apiBaseUrl} />
    </Container>
  </main>

  <Footer />
</Layout>
