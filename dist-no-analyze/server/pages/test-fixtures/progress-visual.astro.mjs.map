---
// Test fixture page for Progress visual regression
import Progress from '@/components/ui/Progress';
import { sampleProps } from '@tests/e2e/fixtures/visual-test-data';

const { state = 'default' } = Astro.url.searchParams;
const props =
  sampleProps.Progress[state as keyof typeof sampleProps.Progress] ?? sampleProps.Progress.default;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Visual Test: Progress - {state}</title>
    <style>
      /* Disable animations for consistent screenshots */
      [data-test-animate='false'],
      [data-test-animate='false'] *,
      [data-test-animate='false'] *::before,
      [data-test-animate='false'] *::after {
        animation-duration: 0s !important;
        animation-delay: -1ms !important;
        transition-duration: 0s !important;
        transition-delay: -1ms !important;
      }
    </style>
  </head>
  <body data-test-animate="false" class="min-h-screen bg-neutral-50 p-8 dark:bg-neutral-900">
    <main>
      <h1 class="sr-only">Progress Component Test</h1>
      <Progress {...props} client:load />
    </main>
  </body>
</html>
