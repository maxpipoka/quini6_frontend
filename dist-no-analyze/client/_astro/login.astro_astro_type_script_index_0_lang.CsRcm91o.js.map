          throw new Error(result.message || 'Credenciales inválidas');
        }

        trackEvent('admin_login', { success: true });

        // Redirect to admin draws or the redirect param
        const urlParams = new URLSearchParams(window.location.search);
        const redirect = urlParams.get('redirect') || '/admin/draws';
        console.log('REDIRECTING TO:', redirect);
        console.log('CURRENT HREF BEFORE:', window.location.href);
        window.location.href = redirect;
        console.log('CURRENT HREF AFTER:', window.location.href);
      } catch (error) {
        console.log('LOGIN ERROR:', error);
        if (!errorMessage.textContent.includes('admin_login_failed')) {
          errorMessage.textContent =
            error instanceof Error ? error.message : 'Error al iniciar sesión';
        }
        errorMessage.classList.remove('hidden');
      } finally {
