# Quini 6 Frontend Environment Variables
# Copy this file to .env and fill in your values

# Required: Backend API base URL (with /api prefix)
VITE_API_BASE_URL=https://your-backend.vercel.app/api

# Required: Frontend site URL (for canonical URLs, sitemap, etc.)
VITE_SITE_URL=https://your-frontend.vercel.app

# Optional: Vercel Deploy Hook Secret (for admin deploy hook endpoint)
# VERCEL_DEPLOY_HOOK_SECRET=your-secret-here

# Node Environment (development, production, test)
NODE_ENV=development