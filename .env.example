# Quini 6 Frontend Environment Variables
# Copy this file to .env and fill in your values

# Required: Backend API base URL (with /api prefix)
VITE_API_BASE_URL=https://your-backend.vercel.app/api

# Required: Frontend site URL (for canonical URLs, sitemap, etc.)
VITE_SITE_URL=https://your-frontend.vercel.app

# Optional: Vercel Deploy Hook Secret (for admin deploy hook endpoint)
# VERCEL_DEPLOY_HOOK_SECRET=your-secret-here

# Optional: Sentry DSN for error tracking (production only)
# VITE_SENTRY_DSN=https://your-key@sentry.io/your-project-id

# Optional: Plausible Analytics domain (enables analytics on admin pages)
# VITE_PLAUSIBLE_DOMAIN=quini6.example.com

# Optional: Enable bundle analysis visualizer (generates stats.html and bundle-stats.json)
# VITE_BUNDLE_ANALYZE=false

# Node Environment (development, production, test)
NODE_ENV=development